---
// src/components/MegaMenu.astro
import { nav } from '../config/site';
---

<div class="megamenu-dropdown" id="megamenu" role="region" aria-label="Catalog Navigation">
  <div class="megamenu-container">
    <!-- Column 1: Wall Art -->
    <div class="megamenu-col">
      <div class="megamenu-col__title">
        <span class="col-icon">🖼️</span>
        <a href="/collections/wall-art">Wall Art</a>
      </div>
      <ul class="megamenu-list">
        {nav.wallArt.map(item => (
          <li>
            <a href={`/collections/${item.slug}`} class="megamenu-item">
              <span class="item-name">{item.label}</span>
            </a>
          </li>
        ))}
      </ul>
      <div class="megamenu-col__sub">
        <a href="/collections/wall-art" class="view-all-link">View All Wall Art &rarr;</a>
      </div>
    </div>

    <!-- Column 2: Lighting & Clocks -->
    <div class="megamenu-col">
      <div class="megamenu-col__title">
        <span class="col-icon">💡</span>
        <a href="/collections/lighting">Lighting</a>
      </div>
      <ul class="megamenu-list">
        {nav.lighting.map(item => (
          <li>
            <a href={`/collections/${item.slug}`} class="megamenu-item">
              <span class="item-name">{item.label}</span>
            </a>
          </li>
        ))}
      </ul>

      <div class="megamenu-col__title" style="margin-top: 1.5rem;">
        <span class="col-icon">🕰️</span>
        <a href="/collections/clocks">Clocks</a>
      </div>
      <ul class="megamenu-list">
        {nav.clocks.map(item => (
          <li>
            <a href={`/collections/${item.slug}`} class="megamenu-item">
              <span class="item-name">{item.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Column 3: Shop by Space -->
    <div class="megamenu-col">
      <div class="megamenu-col__title">
        <span class="col-icon">🏡</span>
        <span>Shop by Space</span>
      </div>
      <ul class="megamenu-list space-pills">
        {nav.spaces.map(item => (
          <li>
            <a href={`/collections/all?space=${item.slug}`} class="megamenu-item space-item">
              <span class="space-bullet"></span>
              <span class="item-name">{item.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Column 4: Shop by Price & Spotlight -->
    <div class="megamenu-col spotlight-col">
      <div class="megamenu-col__title">
        <span class="col-icon">🏷️</span>
        <span>Shop by Price</span>
      </div>
      <div class="price-bands-grid">
        {nav.priceBands.map(item => (
          <a href={`/collections/all?sort=featured${item.min ? `&min=${item.min/100}` : ''}${item.max ? `&max=${item.max/100}` : ''}`} class="price-band-tag">
            {item.label}
          </a>
        ))}
      </div>

      <div class="matra-card">
        <div class="matra-card__tag">DESIGN STUDIO SPOTLIGHT</div>
        <h4 class="matra-card__title">MATRA HAUS</h4>
        <p class="matra-card__desc">Architectural curved birch & fluted acrylic lighting fixtures.</p>
        <a href="/collections/matra-haus" class="matra-card__btn">Explore Studio &rarr;</a>
      </div>
    </div>
  </div>
</div>

<style>
  .megamenu-dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    background: #FFFFFF;
    border-top: 1px solid rgba(43, 27, 20, 0.08);
    border-bottom: 2px solid var(--accent, #B9803A);
    box-shadow: 0 20px 40px -15px rgba(43, 27, 20, 0.15);
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1), transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.25s;
    z-index: 100;
  }

  :global(.nav-has-megamenu:hover) .megamenu-dropdown,
  :global(.nav-has-megamenu:focus-within) .megamenu-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .megamenu-container {
    max-width: 1360px;
    margin: 0 auto;
    padding: 2.25rem 2rem 2.5rem;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2.5rem;
  }

  .megamenu-col__title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-head, 'Cormorant Garamond', Georgia, serif);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--primary, #4A2C1D);
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(43, 27, 20, 0.08);
    margin-bottom: 1rem;
  }

  .megamenu-col__title a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s;
  }

  .megamenu-col__title a:hover {
    color: var(--accent, #B9803A);
  }

  .col-icon {
    font-size: 1.1rem;
  }

  .megamenu-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .megamenu-item {
    display: inline-flex;
    align-items: center;
    color: var(--ink-2, #6B5A50);
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: 400;
    padding: 0.3rem 0;
    transition: all 0.2s ease;
  }

  .megamenu-item:hover {
    color: var(--primary, #4A2C1D);
    transform: translateX(4px);
    font-weight: 500;
  }

  .space-item {
    gap: 0.5rem;
  }

  .space-bullet {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--surface-2, #EADCCB);
    transition: background 0.2s ease;
  }

  .space-item:hover .space-bullet {
    background: var(--accent, #B9803A);
  }

  .view-all-link {
    display: inline-block;
    margin-top: 1rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--accent, #B9803A);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .view-all-link:hover {
    text-decoration: underline;
  }

  .price-bands-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .price-band-tag {
    display: block;
    text-align: center;
    padding: 0.45rem 0.6rem;
    background: var(--bg, #FBF7F1);
    border: 1px solid var(--border, rgba(43,27,20,0.12));
    border-radius: 6px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--ink, #2B1B14);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .price-band-tag:hover {
    background: var(--primary, #4A2C1D);
    color: #FFFFFF;
    border-color: var(--primary, #4A2C1D);
  }

  .matra-card {
    background: linear-gradient(135deg, #3A2013 0%, #4A2C1D 100%);
    border-radius: 8px;
    padding: 1.25rem;
    color: #F8EFE4;
    position: relative;
    overflow: hidden;
  }

  .matra-card::after {
    content: '';
    position: absolute;
    right: -20px;
    bottom: -20px;
    width: 90px;
    height: 90px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(185,128,58,0.3) 0%, transparent 70%);
  }

  .matra-card__tag {
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    font-weight: 700;
    color: #E2B273;
    margin-bottom: 0.25rem;
  }

  .matra-card__title {
    font-family: var(--font-head, 'Cormorant Garamond', Georgia, serif);
    font-size: 1.25rem;
    margin: 0 0 0.35rem 0;
    color: #FFFFFF;
  }

  .matra-card__desc {
    font-size: 0.8125rem;
    color: rgba(248, 239, 228, 0.8);
    margin: 0 0 0.85rem 0;
    line-height: 1.35;
  }

  .matra-card__btn {
    display: inline-block;
    font-size: 0.8125rem;
    font-weight: 600;
    color: #FFFFFF;
    background: rgba(185, 128, 58, 0.8);
    padding: 0.4rem 0.85rem;
    border-radius: 4px;
    text-decoration: none;
    transition: background 0.2s ease;
  }

  .matra-card__btn:hover {
    background: var(--accent, #B9803A);
  }

  @media (max-width: 1024px) {
    .megamenu-dropdown {
      display: none;
    }
  }
</style>

---
// src/components/ProductCard.astro
import { formatPrice } from '../lib/format';
import { site } from '../config/site';

export interface ProductItem {
  id: string;
  slug: string;
  name: string;
  badge?: 'NEW' | 'HOT' | 'SALE' | null;
  brand_line?: string | null;
  price_paise?: number | null;
  compare_at_paise?: number | null;
  primary_image?: string;
  secondary_image?: string;
  default_variant_id?: number;
  has_multiple_prices?: boolean;
  stock?: number | null;
}

interface Props {
  product: ProductItem;
  eagerLoad?: boolean;
}

const { product, eagerLoad = false } = Astro.props;

// Normalize image URLs
const formatImg = (src?: string | null) => {
  if (!src) return '/placeholder-decor.svg';
  if (src.startsWith('http://') || src.startsWith('https://')) return src;
  let s = src.startsWith('/') ? src : '/' + src;
  if (s.startsWith('/products/')) s = '/media' + s;
  return s;
};

const primaryImg = formatImg(product.primary_image);
const secondaryImg = product.secondary_image ? formatImg(product.secondary_image) : undefined;

// Robust Stock calculation
let stockCount: number | null = null;
if (product.stock !== undefined && product.stock !== null && product.stock !== '') {
  const parsed = Number(product.stock);
  if (!isNaN(parsed)) stockCount = parsed;
}
const isOutOfStock = stockCount !== null ? stockCount <= 0 : false;
const isLowStock = stockCount !== null && stockCount > 0 && stockCount < 5;

// Calculate discount percentage if compare_at_paise is present and higher
let discountPercent = 0;
if (product.price_paise && product.compare_at_paise && product.compare_at_paise > product.price_paise) {
  discountPercent = Math.round(((product.compare_at_paise - product.price_paise) / product.compare_at_paise) * 100);
}

const isPriced = typeof product.price_paise === 'number' && product.price_paise > 0;
const whatsappMsg = `Hello ${site.name}, I would like to enquire about availability and custom order for "${product.name}" (${site.url}/products/${product.slug})`;
const whatsappUrl = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(whatsappMsg)}`;
---

<article class={`product-card ${isOutOfStock ? 'is-out-of-stock' : ''}`} data-product-id={product.id}>
  <div class="product-card__media">
    <a href={`/products/${product.slug}`} class="product-card__link" aria-label={product.name}>
      <img
        src={primaryImg}
        alt={product.name}
        class="product-card__img primary-img"
        loading={eagerLoad ? "eager" : "lazy"}
        width="400"
        height="400"
        onerror="this.onerror=null;this.src='/placeholder-decor.svg';"
      />
      {secondaryImg && (
        <img
          src={secondaryImg}
          alt={`${product.name} alternate view`}
          class="product-card__img secondary-img"
          loading="lazy"
          width="400"
          height="400"
          onerror="this.onerror=null;this.src='/placeholder-decor.svg';"
        />
      )}
    </a>

    <!-- Badges -->
    <div class="product-card__badges">
      {isOutOfStock ? (
        <span class="badge badge--out-of-stock">Sold Out</span>
      ) : isLowStock ? (
        <span class="badge badge--low-stock">Only {stockCount} Left</span>
      ) : (
        <>
          {product.badge && (
            <span class={`badge badge--${product.badge.toLowerCase()}`}>
              {product.badge}
            </span>
          )}
          {discountPercent > 0 && !product.badge && (
            <span class="badge badge--sale">{discountPercent}% OFF</span>
          )}
        </>
      )}
      {product.brand_line && (
        <span class="badge badge--brand">{product.brand_line}</span>
      )}
    </div>

    <!-- Wishlist Button -->
    <button
      type="button"
      class="product-card__wishlist"
      aria-label={`Save ${product.name} to wishlist`}
      data-wishlist-id={product.id}
      title="Save to wishlist"
      onclick="window.handleWishlistToggle?.(event, this)"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
      </svg>
    </button>

    <!-- Quick Actions overlay on hover -->
    <div class="product-card__quick-actions">
      <button
        class="quick-view-btn"
        data-quickview-slug={product.slug}
        aria-label={`Quick preview for ${product.name}`}
      >
        <span>Quick View</span>
      </button>
    </div>
  </div>

  <div class="product-card__details">
    <h3 class="product-card__title">
      <a href={`/products/${product.slug}`}>{product.name}</a>
    </h3>

    <!-- Stock Status Tag -->
    <div class="product-card__stock-status">
      {isOutOfStock ? (
        <span class="stock-tag stock-tag--out">✕ Out of Stock</span>
      ) : isLowStock ? (
        <span class="stock-tag stock-tag--low">⚡ Low Stock: Only {stockCount} left</span>
      ) : (
        <span class="stock-tag stock-tag--in">● In Stock</span>
      )}
    </div>

    <div class="product-card__price-row">
      {isPriced ? (
        <div class="price-stack">
          {product.has_multiple_prices && <span class="price-from">From </span>}
          <span class="current-price">{formatPrice(product.price_paise!)}</span>
          {product.compare_at_paise && product.compare_at_paise > product.price_paise! && (
            <span class="compare-price">{formatPrice(product.compare_at_paise)}</span>
          )}
        </div>
      ) : (
        <div class="price-stack price-stack--enquire">
          <span class="price-on-request">Price on request</span>
        </div>
      )}
    </div>

    <div class="product-card__cta">
      {isOutOfStock ? (
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-enquire-whatsapp btn-out-of-stock"
          aria-label={`Enquire about custom order for ${product.name}`}
        >
          <span>Craft on Request</span>
        </a>
      ) : isPriced && product.default_variant_id ? (
        <button
          class="btn-add-to-cart"
          data-variant-id={product.default_variant_id}
          data-product-name={product.name}
          aria-label={`Add ${product.name} to cart`}
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
          <span>Add to Cart</span>
        </button>
      ) : (
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-enquire-whatsapp"
          aria-label={`Enquire on WhatsApp about ${product.name}`}
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
          <span>Enquire on WhatsApp</span>
        </a>
      )}
    </div>
  </div>
</article>

<style>
  .product-card {
    background: #FFFFFF;
    border-radius: var(--radius, 10px);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border, rgba(43,27,20,0.08));
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.25s;
    position: relative;
    height: 100%;
  }

  .product-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 30px rgba(43, 27, 20, 0.1);
    border-color: rgba(185, 128, 58, 0.3);
  }

  .product-card__media {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    background: var(--surface-2, #F3EBDF);
    overflow: hidden;
  }

  .product-card__link {
    display: block;
    width: 100%;
    height: 100%;
    position: relative;
  }

  .product-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
  }

  .secondary-img {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
  }

  .product-card:hover .secondary-img {
    opacity: 1;
  }

  .product-card:hover .primary-img {
    transform: scale(1.04);
  }

  .product-card__badges {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    z-index: 2;
    pointer-events: none;
  }

  .badge {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
    text-transform: uppercase;
  }

  .badge--hot {
    background: #4A2C1D;
    color: #FFFFFF;
  }

  .badge--new {
    background: #2F6B4F;
    color: #FFFFFF;
  }

  .badge--sale {
    background: #A8442A;
    color: #FFFFFF;
  }

  .badge--brand {
    background: #B9803A;
    color: #FFFFFF;
  }

  .badge--out-of-stock {
    background: #4B5563;
    color: #FFFFFF;
  }

  .badge--low-stock {
    background: #D97706;
    color: #FFFFFF;
  }

  .product-card__wishlist {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(4px);
    border: 1px solid rgba(43,27,20,0.08);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ink-2, #6B5A50);
    z-index: 10;
    pointer-events: auto;
    transition: all 0.2s ease;
    box-shadow: 0 2px 8px rgba(0,0,0,0.12);
  }

  .product-card__wishlist svg {
    pointer-events: none;
  }

  .product-card__wishlist:hover {
    color: #A8442A;
    background: #FFFFFF;
    transform: scale(1.12);
  }

  .product-card__wishlist.is-active {
    color: #A8442A;
    background: #FFF5F5;
  }

  .product-card__wishlist.is-active svg path {
    fill: #A8442A;
    stroke: #A8442A;
  }

  .product-card__quick-actions {
    position: absolute;
    bottom: 0.75rem;
    left: 0.75rem;
    right: 0.75rem;
    opacity: 0;
    transform: translateY(8px);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 3;
  }

  .product-card:hover .product-card__quick-actions {
    opacity: 1;
    transform: translateY(0);
  }

  .quick-view-btn {
    width: 100%;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(8px);
    color: var(--primary, #4A2C1D);
    border: 1px solid rgba(43,27,20,0.12);
    font-size: 0.8125rem;
    font-weight: 600;
    padding: 0.55rem;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.2s;
  }

  .quick-view-btn:hover {
    background: var(--primary, #4A2C1D);
    color: #FFFFFF;
  }

  .product-card__details {
    padding: 1.15rem 1.15rem 1.25rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .product-card__title {
    font-family: var(--font-head, 'Cormorant Garamond', Georgia, serif);
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.3;
    margin: 0 0 0.4rem;
    min-height: 2.6em;
  }

  .product-card__title a {
    color: var(--ink, #2B1B14);
    text-decoration: none;
    transition: color 0.2s;
  }

  .product-card__title a:hover {
    color: var(--accent, #B9803A);
  }

  /* Stock Status Pill */
  .product-card__stock-status {
    margin-bottom: 0.65rem;
    display: flex;
    align-items: center;
  }
  .stock-tag {
    font-size: 0.72rem;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    letter-spacing: 0.02em;
  }
  .stock-tag--in {
    color: #065F46;
  }
  .stock-tag--low {
    color: #D97706;
  }
  .stock-tag--out {
    color: #991B1B;
  }

  .product-card__price-row {
    margin-bottom: 0.9rem;
    min-height: 1.6rem;
    display: flex;
    align-items: baseline;
  }

  .price-stack {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
  }

  .price-from {
    font-size: 0.8125rem;
    color: var(--ink-2, #6B5A50);
  }

  .current-price {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--primary, #4A2C1D);
  }

  .compare-price {
    font-size: 0.875rem;
    text-decoration: line-through;
    color: var(--ink-2, #6B5A50);
    opacity: 0.7;
  }

  .price-on-request {
    font-size: 0.9375rem;
    font-style: italic;
    color: var(--ink-2, #6B5A50);
    font-weight: 500;
  }

  .product-card__cta {
    margin-top: auto;
  }

  .btn-add-to-cart,
  .btn-enquire-whatsapp,
  .btn-out-of-stock {
    width: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    padding: 0.6rem 0.85rem;
    border-radius: 6px;
    font-size: 0.8125rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.2s ease;
    box-sizing: border-box;
  }

  .btn-add-to-cart {
    background: var(--primary, #4A2C1D);
    color: #FFFFFF;
    border: none;
  }

  .btn-add-to-cart:hover {
    background: #3A2013;
  }

  .btn-enquire-whatsapp {
    background: #25D366;
    color: #FFFFFF;
    border: none;
  }

  .btn-enquire-whatsapp:hover {
    background: #1EBE5D;
  }

  .btn-out-of-stock {
    background: #F3F4F6;
    color: #4B5563;
    border: 1px solid #D1D5DB;
  }
  .btn-out-of-stock:hover {
    background: #E5E7EB;
  }
</style>

<script>
  // Global Wishlist Toggle Handler for instant response across cards & PDP
  (window as any).handleWishlistToggle = async function(e: Event | null, btn: HTMLElement) {
    if (e) {
      e.preventDefault();
      e.stopPropagation();
    }
    const pId = btn.getAttribute('data-wishlist-id');
    if (!pId) return;

    const isCurrentlyActive = btn.classList.contains('is-active');
    const method = isCurrentlyActive ? 'DELETE' : 'POST';

    try {
      const res = await fetch('/api/wishlist', {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ product_id: pId }),
      });

      // Redirect immediately to login page with return url if unauthenticated
      if (res.status === 401) {
        const currentUrl = window.location.pathname + window.location.search;
        window.location.href = `/login?redirect=${encodeURIComponent(currentUrl)}`;
        return;
      }

      const data = await res.json();
      if (data.requires_login) {
        const currentUrl = window.location.pathname + window.location.search;
        window.location.href = `/login?redirect=${encodeURIComponent(currentUrl)}`;
        return;
      }

      if (res.ok && data.success) {
        // Synchronize all wishlist buttons on the page with this product ID
        document.querySelectorAll(`[data-wishlist-id="${pId}"]`).forEach(el => {
          if (isCurrentlyActive) {
            el.classList.remove('is-active');
          } else {
            el.classList.add('is-active');
          }
        });
      }
    } catch {
      const currentUrl = window.location.pathname + window.location.search;
      window.location.href = `/login?redirect=${encodeURIComponent(currentUrl)}`;
    }
  };

  // Event Delegation for All Product Cards
  document.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement | null;
    if (!target) return;

    // Add to Cart
    const cartBtn = target.closest('.btn-add-to-cart') as HTMLButtonElement | null;
    if (cartBtn) {
      e.preventDefault();
      e.stopPropagation();
      const variantId = Number(cartBtn.getAttribute('data-variant-id') || 1);

      try {
        const cart = JSON.parse(localStorage.getItem('cart') || '[]');
        const existing = cart.find((i: any) => i.variant_id === variantId);
        if (existing) {
          existing.qty += 1;
        } else {
          cart.push({ variant_id: variantId, qty: 1 });
        }
        localStorage.setItem('cart', JSON.stringify(cart));
        (window as any).refreshCartDrawer?.();

        const origHtml = cartBtn.innerHTML;
        cartBtn.innerHTML = '<span>Added! ✓</span>';
        cartBtn.style.background = '#2F6B4F';
        setTimeout(() => {
          cartBtn.innerHTML = origHtml;
          cartBtn.style.background = '';
        }, 1500);
      } catch (err) {
        console.error(err);
      }
      return;
    }

    // Quick View Button
    const qvBtn = target.closest('.quick-view-btn') as HTMLButtonElement | null;
    if (qvBtn) {
      e.preventDefault();
      e.stopPropagation();
      const slug = qvBtn.getAttribute('data-quickview-slug');
      if (slug) {
        window.location.href = `/products/${slug}`;
      }
      return;
    }

    // Wishlist Toggle Button (Delegation Backup)
    const wishBtn = target.closest('.product-card__wishlist') as HTMLButtonElement | null;
    if (wishBtn) {
      (window as any).handleWishlistToggle?.(e, wishBtn);
      return;
    }
  });

  // Sync active wishlist states on page load
  try {
    fetch('/api/wishlist')
      .then(r => r.ok ? r.json() : null)
      .then(data => {
        if (data && data.product_ids && Array.isArray(data.product_ids)) {
          document.querySelectorAll('.product-card__wishlist, .btn-pdp-wishlist').forEach(btn => {
            const pId = btn.getAttribute('data-wishlist-id');
            if (pId && data.product_ids.includes(pId)) {
              btn.classList.add('is-active');
            }
          });
        }
      })
      .catch(() => {});
  } catch {}
</script>

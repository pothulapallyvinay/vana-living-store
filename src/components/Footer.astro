---
// src/components/Footer.astro
import { site, nav } from '../config/site';

const currentYear = new Date().getFullYear();
---

<footer class="site-footer" id="site-footer">
  <!-- Newsletter Ribbon -->
  <section class="footer-newsletter">
    <div class="newsletter-container">
      <div class="newsletter-content">
        <span class="newsletter-badge">THE ARTISAN GUILD</span>
        <h3 class="newsletter-title">Receive Curated Editions & Craft Insights</h3>
        <p class="newsletter-desc">Subscribe to receive exclusive preview drops, seasonal collections, and behind-the-scenes woodcraft stories.</p>
      </div>
      <form class="newsletter-form" id="footer-newsletter-form" action="/api/newsletter" method="POST">
        <div class="input-group">
          <input
            type="email"
            name="email"
            class="newsletter-input"
            placeholder="Enter your email address"
            required
            aria-label="Email address for newsletter"
          />
          <button type="submit" class="newsletter-btn">
            <span>Subscribe</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
        </div>
        <div class="newsletter-msg" id="newsletter-msg" aria-live="polite"></div>
        <span class="privacy-note">We respect your privacy. Unsubscribe at any time.</span>
      </form>
    </div>
  </section>

  <!-- Main Footer Links Grid -->
  <div class="footer-main">
    <div class="footer-container">
      <!-- Col 1: Brand Info -->
      <div class="footer-col brand-col">
        <div class="footer-logo">
          <span class="logo-mark">⚜</span>
          <span class="logo-title">{site.name}</span>
        </div>
        <p class="brand-bio">
          Handcrafting exquisite multi-layered 3D wooden wall sculptures, architectural pendant lighting, and laser-carved clocks in solid birch and walnut. Proudly made in India.
        </p>
        <div class="social-links">
          {site.instagram && (
            <a href={site.instagram} target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="Instagram">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
            </a>
          )}
          {site.facebook && (
            <a href={site.facebook} target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="Facebook">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
            </a>
          )}
          <a href={`https://wa.me/${site.whatsapp}?text=Hello%20${encodeURIComponent(site.name)}%2C%20I%20have%20an%20enquiry`} target="_blank" rel="noopener noreferrer" class="social-icon whatsapp-icon" aria-label="WhatsApp">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
          </a>
        </div>
      </div>

      <!-- Col 2: Collections -->
      <div class="footer-col">
        <h4 class="footer-heading">Collections</h4>
        <ul class="footer-links">
          <li><a href="/collections/mandala-wall-art">Mandala Wall Art</a></li>
          <li><a href="/collections/nature-wildlife">Nature & Wildlife</a></li>
          <li><a href="/collections/spiritual-devotional">Spiritual & Devotional</a></li>
          <li><a href="/collections/pendant-lamps">Pendant Lamps</a></li>
          <li><a href="/collections/table-floor-lamps">Table & Floor Lamps</a></li>
          <li><a href="/collections/wall-clocks">Wall Clocks</a></li>
          <li><a href="/collections/matra-haus">MATRA HAUS Studio</a></li>
        </ul>
      </div>

      <!-- Col 3: Shop by Space -->
      <div class="footer-col">
        <h4 class="footer-heading">Shop by Space</h4>
        <ul class="footer-links">
          {nav.spaces.map(space => (
            <li><a href={`/collections/all?space=${space.slug}`}>{space.label}</a></li>
          ))}
          <li><a href="/bulk-orders">Bulk & Corporate Gifting</a></li>
        </ul>
      </div>

      <!-- Col 4: Client Services & Policies -->
      <div class="footer-col">
        <h4 class="footer-heading">Client Services</h4>
        <ul class="footer-links">
          <li><a href="/about">Artisan Philosophy</a></li>
          <li><a href="/contact">Contact Workshop</a></li>
          <li><a href="/faq">Frequently Asked Questions</a></li>
          <li><a href="/policies/shipping-delivery">Shipping & Delivery</a></li>
          <li><a href="/policies/returns-refunds">Returns & Exchanges</a></li>
          <li><a href="/policies/terms">Terms of Service</a></li>
          <li><a href="/policies/privacy">Privacy Policy</a></li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Bottom Legal Strip & Payment Badges -->
  <div class="footer-bottom">
    <div class="footer-bottom-container">
      <div class="footer-copy">
        <p>&copy; {currentYear} {site.name}. All rights reserved. Handcrafted in India.</p>
        {site.gstin && site.gstin !== '[GSTIN]' ? (
          <p class="gstin-tag">GSTIN: {site.gstin}</p>
        ) : (
          <p class="gstin-tag">GST Registered Enterprise (India)</p>
        )}
      </div>

      <!-- Payment Assurance Badges -->
      <div class="payment-badges" aria-label="Accepted Payment Methods via Razorpay">
        <span class="payment-title">Guaranteed Safe Checkout:</span>
        <div class="badge-row">
          <span class="pay-pill">UPI</span>
          <span class="pay-pill">Google Pay</span>
          <span class="pay-pill">PhonePe</span>
          <span class="pay-pill">Paytm</span>
          <span class="pay-pill">Visa / Mastercard / RuPay</span>
          <span class="pay-pill">Net Banking</span>
          <span class="pay-pill razorpay-pill">Razorpay Verified</span>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: #231610;
    color: #E8DCCF;
    border-top: 1px solid rgba(185, 128, 58, 0.2);
  }

  .footer-newsletter {
    background: linear-gradient(135deg, #3A2013 0%, #2A170E 100%);
    border-bottom: 1px solid rgba(185, 128, 58, 0.15);
    padding: 3.5rem 1.5rem;
  }

  .newsletter-container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  .newsletter-badge {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #E2B273;
    display: inline-block;
    margin-bottom: 0.5rem;
  }

  .newsletter-title {
    font-family: var(--font-head, 'Cormorant Garamond', Georgia, serif);
    font-size: 2rem;
    font-weight: 600;
    color: #FFFFFF;
    margin: 0 0 0.75rem 0;
    line-height: 1.2;
  }

  .newsletter-desc {
    color: rgba(232, 220, 207, 0.8);
    font-size: 0.9375rem;
    margin: 0;
    line-height: 1.5;
  }

  .input-group {
    display: flex;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(185, 128, 58, 0.4);
    border-radius: 6px;
    overflow: hidden;
    transition: border-color 0.2s;
  }

  .input-group:focus-within {
    border-color: #E2B273;
    box-shadow: 0 0 0 3px rgba(185, 128, 58, 0.2);
  }

  .newsletter-input {
    flex: 1;
    background: transparent;
    border: none;
    padding: 0.85rem 1.25rem;
    color: #FFFFFF;
    font-size: 0.9375rem;
    outline: none;
  }

  .newsletter-input::placeholder {
    color: rgba(232, 220, 207, 0.6);
  }

  .newsletter-btn {
    background: var(--accent, #B9803A);
    color: #FFFFFF;
    border: none;
    padding: 0 1.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition: background 0.2s ease;
  }

  .newsletter-btn:hover {
    background: #C99049;
  }

  .privacy-note {
    display: block;
    font-size: 0.75rem;
    color: rgba(232, 220, 207, 0.5);
    margin-top: 0.5rem;
  }

  .newsletter-msg {
    font-size: 0.85rem;
    margin-top: 0.5rem;
  }

  /* Main Footer */
  .footer-main {
    padding: 4.5rem 1.5rem 3.5rem;
  }

  .footer-container {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.8fr 1fr 1fr 1.2fr;
    gap: 3.5rem;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .footer-logo .logo-mark {
    font-size: 1.5rem;
    color: var(--accent, #B9803A);
  }

  .footer-logo .logo-title {
    font-family: var(--font-head, 'Cormorant Garamond', Georgia, serif);
    font-size: 1.5rem;
    font-weight: 700;
    color: #FFFFFF;
  }

  .brand-bio {
    font-size: 0.875rem;
    line-height: 1.6;
    color: rgba(232, 220, 207, 0.75);
    margin-bottom: 1.5rem;
    max-width: 340px;
  }

  .social-links {
    display: flex;
    gap: 0.75rem;
  }

  .social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.06);
    color: #E8DCCF;
    text-decoration: none;
    border: 1px solid rgba(255, 255, 255, 0.1);
    transition: all 0.2s ease;
  }

  .social-icon:hover {
    background: var(--accent, #B9803A);
    color: #FFFFFF;
    border-color: var(--accent, #B9803A);
    transform: translateY(-2px);
  }

  .whatsapp-icon:hover {
    background: #25D366;
    border-color: #25D366;
  }

  .footer-heading {
    font-family: var(--font-head, 'Cormorant Garamond', Georgia, serif);
    font-size: 1.25rem;
    font-weight: 600;
    color: #FFFFFF;
    margin: 0 0 1.25rem 0;
    letter-spacing: 0.02em;
  }

  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .footer-links a {
    color: rgba(232, 220, 207, 0.75);
    text-decoration: none;
    font-size: 0.875rem;
    transition: color 0.2s ease;
  }

  .footer-links a:hover {
    color: #E2B273;
  }

  /* Bottom Strip */
  .footer-bottom {
    background: #190F0B;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding: 1.5rem 1.5rem 2rem;
  }

  .footer-bottom-container {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .footer-copy {
    font-size: 0.8125rem;
    color: rgba(232, 220, 207, 0.6);
  }

  .footer-copy p {
    margin: 0.2rem 0;
  }

  .gstin-tag {
    font-size: 0.75rem;
    color: rgba(232, 220, 207, 0.4);
  }

  .payment-badges {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
  }

  .payment-title {
    font-size: 0.75rem;
    color: rgba(232, 220, 207, 0.7);
    font-weight: 500;
  }

  .badge-row {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .pay-pill {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 4px;
    padding: 0.2rem 0.5rem;
    font-size: 0.6875rem;
    font-weight: 600;
    color: #E8DCCF;
    letter-spacing: 0.02em;
  }

  .razorpay-pill {
    background: rgba(185, 128, 58, 0.2);
    border-color: rgba(185, 128, 58, 0.5);
    color: #E2B273;
  }

  @media (max-width: 1024px) {
    .newsletter-container {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .footer-container {
      grid-template-columns: repeat(2, 1fr);
      gap: 2.5rem;
    }
  }

  @media (max-width: 640px) {
    .footer-container {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .input-group {
      flex-direction: column;
    }
    .newsletter-btn {
      padding: 0.75rem;
      justify-content: center;
    }
    .footer-bottom-container {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>

<script>
  const form = document.getElementById('footer-newsletter-form') as HTMLFormElement | null;
  const msg = document.getElementById('newsletter-msg');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form || !msg) return;
    const formData = new FormData(form);
    try {
      const res = await fetch('/api/newsletter', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: formData.get('email') }),
      });
      const data = await res.json();
      if (res.ok) {
        msg.style.color = '#7AD2A3';
        msg.textContent = '✓ Thank you for subscribing to our artisan editions!';
        form.reset();
      } else {
        msg.style.color = '#F59E9E';
        msg.textContent = data.error || 'Subscription failed. Please try again.';
      }
    } catch {
      msg.style.color = '#F59E9E';
      msg.textContent = 'Network error. Please try again later.';
    }
  });
</script>

---
// src/components/Header.astro
import { site, nav } from '../config/site';
import MegaMenu from './MegaMenu.astro';

interface Props {
  user?: { id: number; first_name: string; last_name: string; role: string } | null;
  cartCount?: number;
}

const { user = null, cartCount = 0 } = Astro.props;
---

<header class="site-header" id="site-header">
  <div class="site-header__main">
    <div class="header-container">
      <!-- Mobile hamburger toggle -->
      <button class="mobile-menu-toggle" id="mobile-menu-toggle" aria-label="Toggle navigation menu" aria-expanded="false" aria-controls="mobile-nav-drawer">
        <svg class="icon-menu" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>

      <!-- Brand Logo -->
      <div class="site-logo">
        <a href="/" class="site-logo__link" aria-label={`${site.name} Home`}>
          <span class="logo-mark">⚜</span>
          <div class="logo-text-group">
            <span class="logo-title">{site.name}</span>
            <span class="logo-sub">{site.tagline}</span>
          </div>
        </a>
      </div>

      <!-- Desktop Navigation -->
      <nav class="desktop-nav" aria-label="Main Navigation">
        <ul class="nav-links">
          <li class="nav-item nav-has-megamenu">
            <a href="/collections/all" class="nav-link" aria-haspopup="true">
              <span>All Collections</span>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </a>
            <MegaMenu />
          </li>
          <li class="nav-item">
            <a href="/collections/wall-art" class="nav-link">Wall Art</a>
          </li>
          <li class="nav-item">
            <a href="/collections/lighting" class="nav-link">Lighting</a>
          </li>
          <li class="nav-item">
            <a href="/collections/clocks" class="nav-link">Clocks</a>
          </li>
          <li class="nav-item">
            <a href="/collections/matra-haus" class="nav-link matra-link">
              <span class="sparkle-dot"></span>
              <span>MATRA HAUS</span>
            </a>
          </li>
          <li class="nav-item">
            <a href="/about" class="nav-link">Artisan Craft</a>
          </li>
          <li class="nav-item">
            <a href="/contact" class="nav-link">Contact</a>
          </li>
        </ul>
      </nav>

      <!-- Right Action Group -->
      <div class="header-actions">
        <!-- Live Search Bar -->
        <div class="search-wrapper" id="search-wrapper">
          <form action="/collections/all" method="GET" class="search-form" id="search-form" role="search">
            <input
              type="search"
              name="q"
              id="search-input"
              class="search-input"
              placeholder="Search mandalas, lamps, clocks..."
              autocomplete="off"
              aria-label="Search products"
            />
            <button type="submit" class="search-submit" aria-label="Submit search">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
            </button>
          </form>
          <!-- Live search dropdown -->
          <div class="search-dropdown" id="search-dropdown" aria-live="polite"></div>
        </div>

        <!-- Account / Login Link -->
        <div class="header-action-item">
          {user ? (
            <a href="/account" class="header-action-btn" aria-label="My Account" title="My Account">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
              </svg>
              <span class="user-greeting">Hi, {user.first_name}</span>
            </a>
          ) : (
            <a href="/login" class="header-action-btn" aria-label="Sign In" title="Sign In">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
              </svg>
            </a>
          )}
        </div>

        <!-- Wishlist Link -->
        <div class="header-action-item">
          <a href="/account/wishlist" class="header-action-btn" aria-label="Wishlist" title="My Wishlist">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
            </svg>
          </a>
        </div>

        <!-- Cart Drawer Button (Cart Badge ALWAYS in DOM) -->
        <div class="header-action-item">
          <button id="cart-btn" class="header-action-btn cart-btn" aria-label="View Shopping Cart" aria-haspopup="dialog">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="9" cy="21" r="1"></circle>
              <circle cx="20" cy="21" r="1"></circle>
              <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
            </svg>
            <span class="cart-badge" id="cart-badge" data-count={String(cartCount)}>{cartCount > 0 ? cartCount : ''}</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div class="mobile-drawer-overlay" id="mobile-drawer-overlay"></div>
  <aside class="mobile-nav-drawer" id="mobile-nav-drawer" aria-label="Mobile Navigation">
    <div class="mobile-drawer-header">
      <span class="mobile-drawer-title">{site.name}</span>
      <button class="mobile-drawer-close" id="mobile-drawer-close" aria-label="Close navigation">✕</button>
    </div>
    <div class="mobile-drawer-body">
      <ul class="mobile-nav-list">
        <li><a href="/collections/all">All Collections &rarr;</a></li>
        <li><a href="/collections/wall-art">Wall Art</a></li>
        <li><a href="/collections/lighting">Lighting</a></li>
        <li><a href="/collections/clocks">Clocks</a></li>
        <li><a href="/collections/matra-haus" class="matra-highlight">MATRA HAUS Studio</a></li>
        <li class="mobile-section-title">Shop by Space</li>
        {nav.spaces.map(s => (
          <li><a href={`/collections/all?space=${s.slug}`} class="mobile-sublink">{s.label}</a></li>
        ))}
        <li class="mobile-section-title">My Account</li>
        <li><a href="/account/wishlist">❤️ My Wishlist</a></li>
        <li><a href="/account">👤 Account Dashboard</a></li>
        <li class="mobile-section-title">More</li>
        <li><a href="/about">Artisan Craft & Story</a></li>
        <li><a href="/bulk-orders">Corporate & Bulk Gifting</a></li>
        <li><a href="/contact">Contact & WhatsApp</a></li>
      </ul>
    </div>
  </aside>
</header>

<style>
  .site-header {
    background: #FFFFFF;
    border-bottom: 1px solid rgba(43, 27, 20, 0.08);
    position: sticky;
    top: 0;
    z-index: 40;
    transition: box-shadow 0.25s ease, background 0.25s ease;
  }

  .site-header.is-scrolled {
    box-shadow: 0 4px 20px rgba(43, 27, 20, 0.08);
  }

  .header-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0.85rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    position: relative;
  }

  .site-logo__link {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: var(--primary, #4A2C1D);
  }

  .logo-mark {
    font-size: 1.6rem;
    color: var(--accent, #B9803A);
    line-height: 1;
    filter: drop-shadow(0 2px 4px rgba(185, 128, 58, 0.2));
  }

  .logo-text-group {
    display: flex;
    flex-direction: column;
  }

  .logo-title {
    font-family: var(--font-head, 'Cormorant Garamond', Georgia, serif);
    font-size: 1.45rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.1;
    color: var(--primary, #4A2C1D);
  }

  .logo-sub {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent, #B9803A);
  }

  .desktop-nav {
    display: flex;
    align-items: center;
  }

  .nav-links {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--ink, #2B1B14);
    text-decoration: none;
    padding: 0.6rem 0.25rem;
    transition: color 0.2s ease;
    position: relative;
  }

  .nav-link:hover {
    color: var(--accent, #B9803A);
  }

  .matra-link {
    color: #8C4325;
    font-weight: 600;
  }

  .sparkle-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #A8442A;
    margin-right: 0.25rem;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.8); }
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .search-wrapper {
    position: relative;
  }

  .search-form {
    display: flex;
    align-items: center;
    background: var(--bg, #FBF7F1);
    border: 1px solid var(--border, rgba(43,27,20,0.12));
    border-radius: 9999px;
    padding: 0.35rem 0.65rem 0.35rem 1rem;
    width: 240px;
    transition: all 0.25s ease;
  }

  .search-form:focus-within {
    border-color: var(--accent, #B9803A);
    background: #FFFFFF;
    width: 290px;
    box-shadow: 0 0 0 3px rgba(185, 128, 58, 0.15);
  }

  .search-input {
    border: none;
    background: transparent;
    font-size: 0.84rem;
    color: var(--ink, #2B1B14);
    width: 100%;
    outline: none;
  }

  .search-input::placeholder {
    color: var(--ink-2, #6B5A50);
    opacity: 0.8;
  }

  .search-submit {
    background: transparent;
    border: none;
    color: var(--ink-2, #6B5A50);
    cursor: pointer;
    padding: 2px;
    display: flex;
    align-items: center;
    transition: color 0.2s;
  }

  .search-submit:hover {
    color: var(--primary, #4A2C1D);
  }

  .search-dropdown {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    width: 340px;
    background: #FFFFFF;
    border: 1px solid rgba(43,27,20,0.12);
    border-radius: 8px;
    box-shadow: 0 10px 25px rgba(43,27,20,0.12);
    display: none;
    z-index: 100;
    max-height: 400px;
    overflow-y: auto;
  }

  .search-dropdown.is-open {
    display: block;
  }

  .header-action-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: transparent;
    border: none;
    color: var(--ink, #2B1B14);
    cursor: pointer;
    padding: 0.45rem;
    border-radius: 6px;
    text-decoration: none;
    position: relative;
    transition: all 0.2s ease;
  }

  .header-action-btn:hover {
    color: var(--accent, #B9803A);
    background: rgba(185, 128, 58, 0.08);
  }

  .user-greeting {
    font-size: 0.8125rem;
    font-weight: 500;
  }

  /* Cart Badge: ALWAYS IN DOM, hidden when data-count="0" or empty */
  .cart-badge {
    position: absolute;
    top: 0;
    right: 0;
    background: var(--sale, #A8442A);
    color: #FFFFFF;
    font-size: 0.6875rem;
    font-weight: 700;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transform: translate(25%, -25%);
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s;
  }

  .cart-badge[data-count="0"],
  .cart-badge:empty {
    opacity: 0;
    pointer-events: none;
    transform: translate(25%, -25%) scale(0.6);
  }

  .mobile-menu-toggle {
    display: none;
    background: transparent;
    border: none;
    color: var(--primary, #4A2C1D);
    cursor: pointer;
    padding: 0.4rem;
  }

  /* Mobile Drawer */
  .mobile-drawer-overlay {
    position: fixed;
    inset: 0;
    background: rgba(43,27,20,0.5);
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s;
    z-index: 1000;
  }

  .mobile-drawer-overlay.is-active {
    opacity: 1;
    visibility: visible;
  }

  .mobile-nav-drawer {
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    width: 320px;
    max-width: 85vw;
    background: #FFFFFF;
    z-index: 1001;
    transform: translateX(-100%);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
    box-shadow: 10px 0 30px rgba(0,0,0,0.15);
  }

  .mobile-nav-drawer.is-active {
    transform: translateX(0);
  }

  .mobile-drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid rgba(43,27,20,0.08);
  }

  .mobile-drawer-title {
    font-family: var(--font-head, 'Cormorant Garamond', Georgia, serif);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--primary, #4A2C1D);
  }

  .mobile-drawer-close {
    background: transparent;
    border: none;
    font-size: 1.25rem;
    cursor: pointer;
    color: var(--ink-2, #6B5A50);
  }

  .mobile-drawer-body {
    padding: 1.25rem 1.5rem;
    overflow-y: auto;
  }

  .mobile-nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .mobile-nav-list a {
    color: var(--ink, #2B1B14);
    text-decoration: none;
    font-size: 1rem;
    font-weight: 500;
    display: block;
    padding: 0.35rem 0;
  }

  .mobile-section-title {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent, #B9803A);
    margin-top: 1rem;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(43,27,20,0.08);
  }

  .mobile-sublink {
    font-size: 0.9rem !important;
    color: var(--ink-2, #6B5A50) !important;
    padding-left: 0.5rem !important;
  }

  .matra-highlight {
    color: #A8442A !important;
    font-weight: 600 !important;
  }

  @media (max-width: 1024px) {
    .desktop-nav {
      display: none;
    }
    .mobile-menu-toggle {
      display: block;
    }
    .search-form {
      width: 180px;
    }
    .search-form:focus-within {
      width: 220px;
    }
  }

  @media (max-width: 640px) {
    .search-form {
      display: none;
    }
    .logo-sub {
      display: none;
    }
  }
</style>

<script>
  // Mobile drawer controls
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const drawer = document.getElementById('mobile-nav-drawer');
  const overlay = document.getElementById('mobile-drawer-overlay');
  const closeBtn = document.getElementById('mobile-drawer-close');

  function openDrawer() {
    drawer?.classList.add('is-active');
    overlay?.classList.add('is-active');
    toggleBtn?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }

  function closeDrawer() {
    drawer?.classList.remove('is-active');
    overlay?.classList.remove('is-active');
    toggleBtn?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  toggleBtn?.addEventListener('click', openDrawer);
  closeBtn?.addEventListener('click', closeDrawer);
  overlay?.addEventListener('click', closeDrawer);

  // Live search suggestions
  const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
  const searchDropdown = document.getElementById('search-dropdown');

  let debounceTimer: number | null = null;
  searchInput?.addEventListener('input', () => {
    const query = searchInput.value.trim();
    if (debounceTimer) clearTimeout(debounceTimer);
    if (query.length < 2) {
      if (searchDropdown) {
        searchDropdown.innerHTML = '';
        searchDropdown.classList.remove('is-open');
      }
      return;
    }

    debounceTimer = window.setTimeout(async () => {
      try {
        const res = await fetch(`/api/search?q=${encodeURIComponent(query)}`);
        if (res.ok) {
          const results = await res.json();
          if (searchDropdown) {
            if (results && results.length > 0) {
              searchDropdown.innerHTML = results.map((p: any) => `
                <a href="/products/${p.slug}" style="display:flex;align-items:center;gap:0.75rem;padding:0.75rem 1rem;text-decoration:none;color:inherit;border-bottom:1px solid rgba(43,27,20,0.06);">
                  <div style="width:40px;height:40px;border-radius:4px;overflow:hidden;background:#F3EBDF;flex-shrink:0;">
                    ${p.image ? `<img src="${p.image}" alt="" style="width:100%;height:100%;object-fit:cover;" />` : ''}
                  </div>
                  <div>
                    <div style="font-size:0.875rem;font-weight:600;color:#2B1B14;">${p.name}</div>
                    <div style="font-size:0.75rem;color:#B9803A;">${p.price ? p.price : 'Price on request'}</div>
                  </div>
                </a>
              `).join('');
              searchDropdown.classList.add('is-open');
            } else {
              searchDropdown.innerHTML = '<div style="padding:1rem;text-align:center;font-size:0.85rem;color:#6B5A50;">No items found</div>';
              searchDropdown.classList.add('is-open');
            }
          }
        }
      } catch {}
    }, 250);
  });

  document.addEventListener('click', (e) => {
    if (!document.getElementById('search-wrapper')?.contains(e.target as Node)) {
      searchDropdown?.classList.remove('is-open');
    }
  });

  // Sticky header scroll shadow
  const header = document.getElementById('site-header');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 20) {
      header?.classList.add('is-scrolled');
    } else {
      header?.classList.remove('is-scrolled');
    }
  }, { passive: true });

  // Cart badge & button
  const cartBtn = document.getElementById('cart-btn');
  cartBtn?.addEventListener('click', () => {
    window.location.href = '/cart';
  });

  function updateCartBadge() {
    try {
      const cart = JSON.parse(localStorage.getItem('cart') || '[]');
      const count = cart.reduce((sum: number, item: any) => sum + (Number(item.qty) || 0), 0);
      const badge = document.getElementById('cart-badge');
      if (badge) {
        badge.textContent = count > 0 ? String(count) : '';
        badge.setAttribute('data-count', String(count));
        badge.style.display = count > 0 ? 'flex' : 'none';
      }
    } catch {}
  }

  (window as any).refreshCartDrawer = updateCartBadge;
  updateCartBadge();
</script>

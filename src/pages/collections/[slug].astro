    { id: 'P23', slug: 'modern-topographic-contoured-3d-layered-wooden-wall-clock', name: 'Modern Topographic Contoured 3D Layered Wooden Wall Clock', badge: null, brand_line: null, price_paise: 349900, compare_at_paise: 429900, primary_image: '/media/products/P23/57.svg', secondary_image: '/media/products/P23/58.svg', default_variant_id: 23, stock: 30 },
    { id: 'P24', slug: '3d-multi-layered-wooden-woman-portrait-red-lips-wall-art-plaque', name: '3D Multi-Layered Wooden Woman Portrait with Red Lips Wall Art Plaque', badge: null, brand_line: null, price_paise: 329900, compare_at_paise: 399900, primary_image: '/media/products/P24/60.svg', secondary_image: '/media/products/P24/61.svg', default_variant_id: 24, stock: 17 },
    { id: 'P25', slug: 'framed-3d-multi-layered-wooden-koi-fish-shadow-box-wall-art', name: 'Framed 3D Multi-Layered Wooden Koi Fish Shadow Box Wall Art', badge: null, brand_line: null, price_paise: 599900, compare_at_paise: 749900, primary_image: '/media/products/P25/63.svg', secondary_image: '/media/products/P25/64.svg', default_variant_id: 25, stock: 19 },
    { id: 'P26', slug: 'circular-3d-multi-layered-wooden-peacock-feather-wall-art-plaque', name: 'Circular 3D Multi-Layered Wooden Peacock Feather Wall Art Plaque', badge: null, brand_line: null, price_paise: 399900, compare_at_paise: 499900, primary_image: '/media/products/P26/66.svg', secondary_image: '/media/products/P26/67.svg', default_variant_id: 26, stock: 20 },
    { id: 'P27', slug: 'matra-haus-aurora-red-curved-acrylic-rib-pendant-lamp', name: 'MATRA HAUS Aurora Red Curved Acrylic Rib Pendant Lamp', badge: 'HOT', brand_line: 'MATRA HAUS', price_paise: 849900, compare_at_paise: 999900, primary_image: '/media/products/P27/69.svg', secondary_image: '/media/products/P27/70.svg', default_variant_id: 27, stock: 14 },
    { id: 'P28', slug: 'matra-haus-organic-fluted-wave-wooden-slat-pendant-light', name: 'MATRA HAUS Organic Fluted Wave Wooden Slat Pendant Light', badge: null, brand_line: 'MATRA HAUS', price_paise: 799900, compare_at_paise: 949900, primary_image: '/media/products/P28/73.svg', secondary_image: '/media/products/P28/74.svg', default_variant_id: 28, stock: 11 },
    { id: 'P29', slug: 'framed-3d-multi-layered-wooden-tree-of-life-filigree-relief-artwork', name: 'Framed 3D Multi-Layered Wooden Tree of Life Filigree Relief Artwork', badge: null, brand_line: null, price_paise: 449900, compare_at_paise: 549900, primary_image: '/media/products/P29/75.svg', secondary_image: '/media/products/P29/77.svg', default_variant_id: 29, stock: 23 },
    { id: 'P30', slug: 'sacred-om-aum-lotus-3d-multi-layered-wooden-mandala-wall-art', name: 'Sacred Om (Aum) Lotus 3D Multi-Layered Wooden Mandala Wall Art', badge: null, brand_line: null, price_paise: 399900, compare_at_paise: 499900, primary_image: '/media/products/P30/79.svg', secondary_image: null, default_variant_id: 30, stock: 16 },
    { id: 'P31', slug: 'lord-ganesha-on-lotus-3d-multi-layered-colorful-wooden-wall-art', name: 'Lord Ganesha on Lotus 3D Multi-Layered Colorful Wooden Wall Art', badge: 'HOT', brand_line: null, price_paise: 499900, compare_at_paise: 649900, primary_image: '/media/products/P31/80.svg', secondary_image: null, default_variant_id: 31, stock: 14 },
    { id: 'P32', slug: 'framed-3d-multi-layered-wooden-world-map-topographic-ocean-depth-relief', name: 'Framed 3D Multi-Layered Wooden World Map Topographic Ocean Depth Relief Art', badge: null, brand_line: null, price_paise: 899900, compare_at_paise: 1099900, primary_image: '/media/products/P32/81.svg', secondary_image: '/media/products/P32/82.svg', default_variant_id: 32, stock: 12 },
  ];

  if (slug === 'matra-haus') {
    products = ALL_32.filter(p => p.brand_line === 'MATRA HAUS');
  } else if (slug && slug.includes('lamp')) {
    products = ALL_32.filter(p => p.id === 'P04' || p.id === 'P05' || p.id === 'P14' || p.id === 'P15' || p.id === 'P16' || p.id === 'P17' || p.id === 'P27' || p.id === 'P28');
  } else if (slug && slug.includes('clock')) {
    products = ALL_32.filter(p => ['P20', 'P21', 'P22', 'P23'].includes(p.id));
  } else {
    products = ALL_32.slice(offset, offset + pageSize);
  }
  totalCount = ALL_32.length;
}

const totalPages = Math.ceil(totalCount / pageSize);

// Helper to preserve parameters
function buildUrl(newParams: Record<string, string | number | null>) {
  const p = new URLSearchParams(url.searchParams);
  for (const [key, val] of Object.entries(newParams)) {
    if (val === null || val === '') {
      p.delete(key);
    } else {
      p.set(key, String(val));
    }
  }
  return `?${p.toString()}`;
}

products = (products || []).map((p: any) => {
  let m1 = p.primary_image || `/media/products/${p.id}/1.svg`;
  if (!m1.startsWith('http://') && !m1.startsWith('https://')) {
    if (!m1.startsWith('/')) m1 = '/' + m1;
    if (m1.startsWith('/products/')) m1 = '/media' + m1;
  }
  let m2 = p.secondary_image;
  if (m2 && !m2.startsWith('http://') && !m2.startsWith('https://')) {
    if (!m2.startsWith('/')) m2 = '/' + m2;
    if (m2.startsWith('/products/')) m2 = '/media' + m2;
  }
  return { ...p, primary_image: m1, secondary_image: m2 };
});
---

<Base
  title={`${collection.title} — ${site.name}`}
  description={collection.desc}
>
  <!-- Collection Header -->
  <div class="collection-header">
    <div class="site-container">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li><span>/</span></li>
          <li><a href="/collections/all">Collections</a></li>
          <li><span>/</span></li>
          <li aria-current="page"><strong>{collection.title}</strong></li>
        </ol>
      </nav>

      <h1 class="collection-title">{collection.title}</h1>
      <p class="collection-desc">{collection.desc}</p>
    </div>
  </div>

  <div class="site-container collection-layout-wrapper">
    <!-- Filter Sidebar (sticky 260px) -->
    <aside class="filter-sidebar" id="filter-sidebar" aria-label="Product Filters">
      <div class="filter-sidebar__header">
        <h3 class="filter-title">Filters</h3>
        {(currentSpace || currentBadge || minPrice || maxPrice) && (
          <a href={`/collections/${slug || 'all'}`} class="filter-clear-all">Reset All</a>
        )}
      </div>

      <!-- Categories & Sub-collections -->
      <div class="filter-group">
        <h4 class="filter-group-title">Category</h4>
        <ul class="filter-links-list">
          <li class={slug === 'all' ? 'is-active' : ''}>
            <a href={`/collections/all${buildUrl({ page: 1 })}`}>All Collections</a>
          </li>
          <li class={slug === 'wall-art' ? 'is-active' : ''}>
            <a href={`/collections/wall-art${buildUrl({ page: 1 })}`}>Wall Art & Mandalas</a>
          </li>
          <li class={slug === 'lighting' ? 'is-active' : ''}>
            <a href={`/collections/lighting${buildUrl({ page: 1 })}`}>Designer Lighting</a>
          </li>
          <li class={slug === 'clocks' ? 'is-active' : ''}>
            <a href={`/collections/clocks${buildUrl({ page: 1 })}`}>Clocks</a>
          </li>
          <li class={slug === 'matra-haus' ? 'is-active' : ''}>
            <a href={`/collections/matra-haus${buildUrl({ page: 1 })}`}>MATRA HAUS Studio</a>
          </li>
        </ul>
      </div>

      <!-- Shop by Space Tags -->
      <div class="filter-group">
        <h4 class="filter-group-title">Shop by Space</h4>
        <div class="space-pills-filter">
          {nav.spaces.map(sp => (
            <a
              href={buildUrl({ space: currentSpace === sp.slug ? null : sp.slug, page: 1 })}
              class={`filter-pill ${currentSpace === sp.slug ? 'is-active' : ''}`}
            >
              {sp.label}
            </a>
          ))}
        </div>
      </div>

      <!-- Badges -->
      <div class="filter-group">
        <h4 class="filter-group-title">Curated Tags</h4>
        <div class="space-pills-filter">
          <a href={buildUrl({ badge: currentBadge === 'HOT' ? null : 'HOT', page: 1 })} class={`filter-pill ${currentBadge === 'HOT' ? 'is-active' : ''}`}>
            HOT
          </a>
          <a href={buildUrl({ badge: currentBadge === 'NEW' ? null : 'NEW', page: 1 })} class={`filter-pill ${currentBadge === 'NEW' ? 'is-active' : ''}`}>
            NEW
          </a>
          <a href={buildUrl({ badge: currentBadge === 'SALE' ? null : 'SALE', page: 1 })} class={`filter-pill ${currentBadge === 'SALE' ? 'is-active' : ''}`}>
            SALE
          </a>
        </div>
      </div>

      <!-- Price Range Slider & Inputs -->
      <div class="filter-group">
        <h4 class="filter-group-title">Price Range (₹)</h4>
        <form method="GET" class="price-filter-form">
          {currentSpace && <input type="hidden" name="space" value={currentSpace} />}
          {currentBadge && <input type="hidden" name="badge" value={currentBadge} />}
          {currentSort && <input type="hidden" name="sort" value={currentSort} />}

          <div class="price-inputs-row">
            <input
              type="number"
              name="min"
              placeholder="Min"
              value={minPrice}
              class="price-range-input"
              min="0"
              step="500"
            />
            <span class="price-dash">–</span>
            <input
              type="number"
              name="max"
              placeholder="Max"
              value={maxPrice}
              class="price-range-input"
              min="0"
              step="500"
            />
            <button type="submit" class="price-apply-btn">Go</button>
          </div>
        </form>
      </div>
    </aside>

    <!-- Main Listing Area -->
    <main class="collection-main">
      <!-- Toolbar: Result Count, Grid Column Toggle, Sort Dropdown -->
      <div class="collection-toolbar">
        <div class="toolbar-left">
          <span class="results-count">
            Showing <strong>{products.length}</strong> of <strong>{totalCount || products.length}</strong> items in <em>{collection.title}</em>
          </span>
        </div>

        <div class="toolbar-right">
          <!-- Desktop Grid Column Toggles (2/3/4) -->
          <div class="grid-toggles" id="grid-toggles" aria-label="Grid layout toggle">
            <button class="grid-toggle-btn" data-cols="2" aria-label="2 columns">2</button>
            <button class="grid-toggle-btn is-active" data-cols="3" aria-label="3 columns">3</button>
            <button class="grid-toggle-btn" data-cols="4" aria-label="4 columns">4</button>
          </div>

          <!-- Sort Dropdown -->
          <div class="sort-select-wrapper">
            <label for="sort-dropdown" class="sr-only">Sort by</label>
            <select id="sort-dropdown" class="sort-select" onchange="window.location.href = this.value">
              <option value={buildUrl({ sort: 'featured', page: 1 })} selected={currentSort === 'featured'}>Featured Editions</option>
              <option value={buildUrl({ sort: 'newest', page: 1 })} selected={currentSort === 'newest'}>Newest Additions</option>
              <option value={buildUrl({ sort: 'bestseller', page: 1 })} selected={currentSort === 'bestseller'}>Best Selling</option>
              <option value={buildUrl({ sort: 'price_asc', page: 1 })} selected={currentSort === 'price_asc'}>Price: Low to High</option>
              <option value={buildUrl({ sort: 'price_desc', page: 1 })} selected={currentSort === 'price_desc'}>Price: High to Low</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Products Grid -->
      {products.length > 0 ? (
        <div class="collection-grid cols-3" id="collection-grid">
          {products.map((prod, idx) => (
            <ProductCard product={prod} eagerLoad={idx < 6} />
          ))}
        </div>
      ) : (
        <div class="empty-state-box">
          <div class="empty-icon">🪵</div>
          <h3>No matching handcrafted pieces found</h3>
          <p>Try clearing your active filters or expanding the price range to explore more artisan items.</p>
          <a href={`/collections/${slug || 'all'}`} class="btn-clear-filters">Clear All Filters</a>
        </div>
      )}

      <!-- Pagination -->
      {totalPages > 1 && (
        <nav class="pagination-nav" aria-label="Pagination">
          {currentPage > 1 && (
            <a href={buildUrl({ page: currentPage - 1 })} class="pagination-btn">&larr; Previous</a>
          )}
          <span class="pagination-status">Page {currentPage} of {totalPages}</span>
          {currentPage < totalPages && (
            <a href={buildUrl({ page: currentPage + 1 })} class="pagination-btn">Next &rarr;</a>
          )}
        </nav>
      )}
    </main>
  </div>
</Base>


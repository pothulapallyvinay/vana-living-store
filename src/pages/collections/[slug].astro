---
// src/pages/collections/[slug].astro
// Collection listing with dynamic 260px filter sidebar, 2/3/4 column grid toggle, and parameterised SQL
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import { site, nav } from '../../config/site';
import { getDB, all, one } from '../../lib/db';

const { slug } = Astro.params;
const url = Astro.url;

// Query parameters
const currentSpace = url.searchParams.get('space') || '';
const currentSort = url.searchParams.get('sort') || 'featured';
const minPrice = url.searchParams.get('min') || '';
const maxPrice = url.searchParams.get('max') || '';
const currentBadge = url.searchParams.get('badge') || '';
const currentPage = parseInt(url.searchParams.get('page') || '1', 10);
const pageSize = 12;
const offset = (currentPage - 1) * pageSize;

const env = (Astro.locals as any).runtime?.env || (process.env as any);

// Collection metadata definitions
const COLLECTION_INFO: Record<string, { title: string; desc: string; banner?: string }> = {
  'all': {
    title: 'All Handcrafted Collections',
    desc: 'Browse our complete catalog of 32 artisanal 3D layered wooden sculptures, designer lighting fixtures, and laser-crafted clocks.',
  },
  'wall-art': {
    title: '3D Multi-Layered Wooden Wall Art',
    desc: 'Intricate concentric mandalas, nature wildlife portraits, and figurative sculptures with up to 9 stacked architectural tiers.',
  },
  'mandala-wall-art': {
    title: 'Mandala Wall Art',
    desc: 'Concentric geometric mandalas and sacred wall medallions with precision laser filigree.',
  },
  'nature-wildlife': {
    title: 'Nature & Wildlife Art',
    desc: 'Vibrant peacocks, royal tigers, swimming koi fish, and Trees of Life carved in dimensional birch.',
  },
  'figures-portraits': {
    title: 'Figures & Portraits',
    desc: 'Feminine silhouettes, mother and child reliefs, and expressive pop-art portraits.',
  },
  'spiritual-devotional': {
    title: 'Spiritual & Devotional Décor',
    desc: 'Sacred Aum mandalas and Lord Ganesha on lotus throne designed for serene home pooja rooms.',
  },
  'maps-abstract': {
    title: 'Maps & Abstract Art',
    desc: 'Multi-layer bathymetric ocean depth world maps and cubist three-faces relief sculptures.',
  },
  'lighting': {
    title: 'Designer Wooden Lamps & Lighting',
    desc: 'Architectural pinecone pendant shades, curved slat table lamps, and lotus acrylic LED night lights.',
  },
  'pendant-lamps': {
    title: 'Pendant Lamps & Chandeliers',
    desc: 'Suspended wooden luminaires casting intricate ambient shadow patterns across ceilings and walls.',
  },
  'table-floor-lamps': {
    title: 'Table & Standing Floor Lamps',
    desc: 'Warm ambient illumination for bedside nightstands, sideboards, and living room corners.',
  },
  'night-lights': {
    title: 'LED Ambient Night Lights',
    desc: 'Edge-lit laser-engraved acrylic and wood nightstands with gentle 3000K warm glow.',
  },
  'clocks': {
    title: 'Laser-Crafted Wooden Clocks',
    desc: 'Dimensional wall timepieces and minimalist desk clocks with silent German quartz movements.',
  },
  'wall-clocks': {
    title: 'Artisan Wall Clocks',
    desc: 'Statement topographic, mandala, and asymmetric walnut clocks for living rooms and executive suites.',
  },
  'desk-clocks': {
    title: 'Minimalist Desk Clocks',
    desc: 'Compact desktop circular timepieces crafted from multi-layer natural timber.',
  },
  'matra-haus': {
    title: 'MATRA HAUS Design Studio',
    desc: 'Signature architectural fixtures with fluid curved birch slats and fluted acrylic forms.',
  },
};

const collection = COLLECTION_INFO[slug || 'all'] || {
  title: slug ? slug.replace(/-/g, ' ').replace(/\b\w/g, l => l.toUpperCase()) : 'Collection',
  desc: 'Handcrafted artisan home décor creations made in India.',
};

let products: any[] = [];
let totalCount = 0;

if (env?.DB) {
  try {
    const db = getDB(env);
    const conditions: string[] = ['p.is_active = 1'];
    const params: any[] = [];

    // Filter by collection / category
    if (slug && slug !== 'all') {
      if (slug === 'matra-haus') {
        conditions.push("p.brand_line = 'MATRA HAUS'");
      } else {
        conditions.push(`p.id IN (
          SELECT pc.product_id FROM product_categories pc
          JOIN categories c ON c.id = pc.category_id
          WHERE c.slug = ? OR c.parent_id IN (SELECT id FROM categories WHERE slug = ?)
        )`);
        params.push(slug, slug);
      }
    }

    // Filter by space tag
    if (currentSpace) {
      conditions.push(`p.id IN (SELECT product_id FROM product_tags WHERE tag = ?)`);
      params.push(currentSpace);
    }

    // Filter by badge
    if (currentBadge) {
      conditions.push(`p.badge = ?`);
      params.push(currentBadge);
    }

    // Filter by price range
    if (minPrice) {
      conditions.push(`v.price_paise >= ?`);
      params.push(Number(minPrice) * 100);
    }
    if (maxPrice) {
      conditions.push(`v.price_paise <= ?`);
      params.push(Number(maxPrice) * 100);
    }

    const whereClause = conditions.length > 0 ? `WHERE ${conditions.join(' AND ')}` : '';

    // Count total matching items
    const countRow = await one<{ count: number }>(
      db,
      `SELECT COUNT(DISTINCT p.id) as count
       FROM products p
       LEFT JOIN product_variants v ON v.product_id = p.id AND v.is_default = 1
       ${whereClause}`,
      params
    );
    totalCount = countRow?.count || 0;

    // Sorting
    let orderBy = 'p.is_featured DESC, p.id ASC';
    if (currentSort === 'newest') orderBy = 'p.created_at DESC';
    if (currentSort === 'bestseller') orderBy = 'p.is_bestseller DESC, p.id ASC';
    if (currentSort === 'price_asc') orderBy = 'v.price_paise ASC NULLS LAST';
    if (currentSort === 'price_desc') orderBy = 'v.price_paise DESC NULLS LAST';

    // Query paginated products
    products = await all(
      db,
      `SELECT p.id, p.slug, p.name, p.badge, p.brand_line,
        v.id as default_variant_id, v.price_paise, v.compare_at_paise, v.stock,
        m1.path as primary_image, m2.path as secondary_image
       FROM products p
       LEFT JOIN product_variants v ON v.product_id = p.id AND v.is_default = 1
       LEFT JOIN product_media m1 ON m1.product_id = p.id AND m1.is_primary = 1
       LEFT JOIN product_media m2 ON m2.product_id = p.id AND m2.sort_order = 2 AND m2.is_watermarked = 0
       ${whereClause}
       ORDER BY ${orderBy}
       LIMIT ? OFFSET ?`,
      [...params, pageSize, offset]
    );
  } catch (err) {
    console.error('Collection fetch error:', err);
  }
}

// Fallback seed catalog if database has not been initialized yet
if (products.length === 0 && totalCount === 0) {
  const ALL_32 = [

    { id: 'P03', slug: '3d-multi-layered-wooden-woman-profile-silhouette-wall-art-plaque', name: '3D Multi-Layered Wooden Woman Profile Silhouette Wall Art Plaque', badge: null, brand_line: null, price_paise: 299900, compare_at_paise: 379900, primary_image: '/media/products/P03/7.svg', secondary_image: '/media/products/P03/8.svg', default_variant_id: 3, stock: 30 },
    { id: 'P04', slug: 'geometric-cutout-wooden-artichoke-pendant-lamp-shade', name: 'Geometric Cutout Wooden Artichoke Pendant Lamp Shade', badge: null, brand_line: null, price_paise: 649900, compare_at_paise: 799900, primary_image: '/media/products/P04/10.svg', secondary_image: '/media/products/P04/11.svg', default_variant_id: 4, stock: 22 },
    { id: 'P05', slug: 'curved-slat-wooden-lantern-table-lamp-trio', name: 'Curved Slat Wooden Lantern Table Lamp Trio', badge: 'HOT', brand_line: null, price_paise: 449900, compare_at_paise: 549900, primary_image: '/media/products/P05/13.svg', secondary_image: '/media/products/P05/14.svg', default_variant_id: 5, stock: 15 },
    { id: 'P06', slug: 'framed-3d-multi-layered-wooden-filigree-floral-mandala-wall-art', name: 'Framed 3D Multi-Layered Wooden Filigree Floral Mandala Wall Art', badge: null, brand_line: null, price_paise: 399900, compare_at_paise: 499900, primary_image: '/media/products/P06/16.svg', secondary_image: '/media/products/P06/17.svg', default_variant_id: 6, stock: 20 },
    { id: 'P07', slug: 'framed-3d-multi-layered-wooden-peacock-wall-art', name: 'Framed 3D Multi-Layered Wooden Peacock Wall Art', badge: null, brand_line: null, price_paise: 549900, compare_at_paise: 699900, primary_image: '/media/products/P07/18.svg', secondary_image: '/media/products/P07/19.svg', default_variant_id: 7, stock: 16 },
    { id: 'P08', slug: 'framed-3d-multi-layered-wooden-tiger-eyes-wall-art-plaque', name: 'Framed 3D Multi-Layered Wooden Tiger Eyes Wall Art Plaque', badge: null, brand_line: null, price_paise: 429900, compare_at_paise: 529900, primary_image: '/media/products/P08/21.svg', secondary_image: '/media/products/P08/22.svg', default_variant_id: 8, stock: 14 },
    { id: 'P09', slug: '3d-multi-layered-wooden-semi-circular-peacock-tail-fan-wall-art', name: '3D Multi-Layered Wooden Semi-Circular Peacock Tail Fan Wall Art', badge: null, brand_line: null, price_paise: 599900, compare_at_paise: 749900, primary_image: '/media/products/P09/23.svg', secondary_image: '/media/products/P09/24.svg', default_variant_id: 9, stock: 19 },
    { id: 'P10', slug: 'semi-circular-3d-multi-layered-wooden-mandala-wall-art-headboard', name: 'Semi-Circular 3D Multi-Layered Wooden Mandala Wall Art Headboard', badge: 'HOT', brand_line: null, price_paise: 799900, compare_at_paise: 999900, primary_image: '/media/products/P10/26.svg', secondary_image: '/media/products/P10/27.svg', default_variant_id: 10, stock: 12 },

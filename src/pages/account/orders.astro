---
// src/pages/account/orders.astro
import Base from '../../layouts/Base.astro';
import { site } from '../../config/site';
import { getDB, all } from '../../lib/db';
import { formatPrice } from '../../lib/format';

const user = (Astro.locals as any).user;
if (!user) return Astro.redirect('/login?redirect=/account/orders');

const env = (Astro.locals as any).runtime?.env || (process.env as any);
let orders: any[] = [];
if (env?.DB) {
  try {
    const db = getDB(env);
    orders = await all(db, `SELECT * FROM orders WHERE user_id = ? ORDER BY id DESC`, [user.id]);
  } catch {}
}
---

<Base title={`My Orders — ${site.name}`}>
  <div class="site-container account-container">
    <div class="account-layout">
      <!-- Sidebar -->
      <aside class="account-sidebar">
        <div class="user-avatar-card">
          <div class="avatar-circle">{user.first_name[0]}{user.last_name[0]}</div>
          <strong class="user-display-name">{user.first_name} {user.last_name}</strong>
          <span class="user-email-text">{user.email}</span>
        </div>
        <nav class="account-nav-list">
          <a href="/account" class="account-nav-link"><span>📊</span><span>Dashboard</span></a>
          <a href="/account/orders" class="account-nav-link is-active"><span>📦</span><span>My Orders</span></a>
          <a href="/account/wishlist" class="account-nav-link"><span>❤️</span><span>My Wishlist</span></a>
          <a href="/account/profile" class="account-nav-link"><span>👤</span><span>Profile Details</span></a>
          <a href="/account/addresses" class="account-nav-link"><span>📍</span><span>Saved Addresses</span></a>
          <a href="/account/password" class="account-nav-link"><span>🔑</span><span>Security & Password</span></a>
          <a href="/logout" class="account-nav-link text-danger"><span>🚪</span><span>Log Out</span></a>
        </nav>
      </aside>

      <!-- Main Panel -->
      <main class="account-main">
        <h1 class="account-heading">Order History</h1>
        <p class="account-sub">View status timeline, courier tracking details, and printable invoices.</p>

        {orders.length > 0 ? (
          <div class="orders-list">
            {orders.map(o => (
              <div class="order-box-card">
                <div class="order-box-header">
                  <div>
                    <span class="order-ref">Order #{o.order_number}</span>
                    <span class="order-date">Placed on {new Date(o.created_at).toLocaleDateString('en-IN', { month: 'long', day: 'numeric', year: 'numeric' })}</span>
                  </div>
                  <div class="order-box-actions">
                    <span class={`status-badge status-badge--${o.status}`}>{o.status}</span>
                    <a href={`/order/${o.order_number}?token=${o.access_token}`} class="btn-track-order">
                      View Order & Track &rarr;
                    </a>
                  </div>
                </div>
                <div class="order-box-body">
                  <div class="order-price-info">
                    <span>Total Amount: <strong>{formatPrice(o.total_paise)}</strong></span>
                    <span class="payment-method-tag">Method: {o.payment_method === 'online' ? 'Razorpay' : 'COD'}</span>
                  </div>
                  {o.tracking_number && (
                    <div class="tracking-snippet">
                      <span>Courier: <strong>{o.courier}</strong> (AWB: <code>{o.tracking_number}</code>)</span>
                    </div>
                  )}
                </div>
              </div>
            ))}
          </div>
        ) : (
          <div class="empty-state">
            <p>You have no orders on record.</p>
            <a href="/collections/all" class="btn-browse">Browse Artisanal Décor &rarr;</a>
          </div>
        )}
      </main>
    </div>
  </div>
</Base>

<style>
  .account-container { padding-top: 3rem; padding-bottom: 6rem; }
  .account-layout { display: grid; grid-template-columns: 260px 1fr; gap: 3rem; align-items: start; }
  .account-sidebar { background: #FFFFFF; border: 1px solid var(--border, rgba(43,27,20,0.1)); border-radius: var(--radius, 10px); overflow: hidden; position: sticky; top: 5.5rem; }
  .user-avatar-card { padding: 1.75rem 1.5rem; background: #FAF5EE; border-bottom: 1px solid rgba(43,27,20,0.08); display: flex; flex-direction: column; align-items: center; text-align: center; }
  .avatar-circle { width: 60px; height: 60px; border-radius: 50%; background: var(--primary, #4A2C1D); color: #E2B273; display: flex; align-items: center; justify-content: center; font-size: 1.35rem; font-weight: 700; margin-bottom: 0.75rem; }
  .user-display-name { font-size: 1.05rem; color: var(--primary, #4A2C1D); }
  .user-email-text { font-size: 0.75rem; color: var(--ink-2, #6B5A50); }
  .account-nav-list { padding: 0.75rem; display: flex; flex-direction: column; gap: 0.25rem; }
  .account-nav-link { display: flex; align-items: center; gap: 0.65rem; padding: 0.65rem 0.85rem; border-radius: 6px; font-size: 0.875rem; font-weight: 500; color: var(--ink, #2B1B14); text-decoration: none; }
  .account-nav-link.is-active { background: var(--primary, #4A2C1D); color: #FFFFFF; font-weight: 600; }
  .text-danger { color: #A8442A !important; }
  .account-heading { font-family: var(--font-head, 'Cormorant Garamond', Georgia, serif); font-size: 2.3rem; font-weight: 700; color: var(--primary, #4A2C1D); margin: 0 0 0.4rem; }
  .account-sub { font-size: 0.95rem; color: var(--ink-2, #6B5A50); margin: 0 0 2rem; }
  .orders-list { display: flex; flex-direction: column; gap: 1.25rem; }
  .order-box-card { background: #FFFFFF; border: 1px solid var(--border, rgba(43,27,20,0.1)); border-radius: var(--radius, 10px); padding: 1.5rem; }
  .order-box-header { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(43,27,20,0.06); padding-bottom: 1rem; margin-bottom: 1rem; flex-wrap: wrap; gap: 0.5rem; }
  .order-ref { display: block; font-size: 1.1rem; font-weight: 700; color: var(--primary, #4A2C1D); }
  .order-date { font-size: 0.8125rem; color: var(--ink-2, #6B5A50); }
  .order-box-actions { display: flex; align-items: center; gap: 1rem; }
  .btn-track-order { font-size: 0.84rem; font-weight: 600; color: var(--accent, #B9803A); text-decoration: none; }
  .order-price-info { display: flex; justify-content: space-between; font-size: 0.9rem; }
  .payment-method-tag { font-size: 0.8125rem; color: var(--ink-2, #6B5A50); }
  .tracking-snippet { margin-top: 0.75rem; background: #FAF5EE; padding: 0.5rem 0.75rem; border-radius: 6px; font-size: 0.8125rem; color: var(--primary, #4A2C1D); }
  .empty-state { text-align: center; background: #FFFFFF; padding: 4rem 2rem; border-radius: 10px; border: 1px dashed rgba(43,27,20,0.2); }
  .btn-browse { display: inline-block; background: var(--primary, #4A2C1D); color: #FFFFFF; padding: 0.75rem 1.75rem; border-radius: 6px; text-decoration: none; font-weight: 600; margin-top: 1rem; }
  @media (max-width: 900px) { .account-layout { grid-template-columns: 1fr; } }
</style>

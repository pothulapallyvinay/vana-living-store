---
// src/pages/account/password.astro
import Base from '../../layouts/Base.astro';
import { site } from '../../config/site';

const user = (Astro.locals as any).user;
if (!user) return Astro.redirect('/login?redirect=/account/password');
---

<Base title={`Security & Password — ${site.name}`}>
  <div class="site-container account-container">
    <div class="account-layout">
      <!-- Sidebar -->
      <aside class="account-sidebar">
        <div class="user-avatar-card">
          <div class="avatar-circle">{user.first_name[0]}{user.last_name[0]}</div>
          <strong class="user-display-name">{user.first_name} {user.last_name}</strong>
          <span class="user-email-text">{user.email}</span>
        </div>
        <nav class="account-nav-list">
          <a href="/account" class="account-nav-link"><span>📊</span><span>Dashboard</span></a>
          <a href="/account/orders" class="account-nav-link"><span>📦</span><span>My Orders</span></a>
          <a href="/account/wishlist" class="account-nav-link"><span>❤️</span><span>My Wishlist</span></a>
          <a href="/account/profile" class="account-nav-link"><span>👤</span><span>Profile Details</span></a>
          <a href="/account/addresses" class="account-nav-link"><span>📍</span><span>Saved Addresses</span></a>
          <a href="/account/password" class="account-nav-link is-active"><span>🔑</span><span>Security & Password</span></a>
          <a href="/logout" class="account-nav-link text-danger"><span>🚪</span><span>Log Out</span></a>
        </nav>
      </aside>

      <!-- Main Panel -->
      <main class="account-main">
        <h1 class="account-heading">Change Password</h1>
        <p class="account-sub">Keep your artisan account secure with a strong password.</p>

        <div class="password-card">
          <div id="pw-alert" class="alert-box" style="display:none;" role="alert"></div>

          <form id="change-password-form">
            <div class="form-group">
              <label for="current_password">Current Password *</label>
              <input type="password" id="current_password" name="current_password" required />
            </div>

            <div class="form-group">
              <label for="new_password">New Password (minimum 8 characters) *</label>
              <input type="password" id="new_password" name="new_password" minlength="8" required />
            </div>

            <div class="form-group">
              <label for="confirm_password">Confirm New Password *</label>
              <input type="password" id="confirm_password" name="confirm_password" minlength="8" required />
            </div>

            <button type="submit" id="btn-save-pw" class="btn-primary">
              <span>Update Password</span>
            </button>
          </form>
        </div>
      </main>
    </div>
  </div>
</Base>

<style>
  .account-container { padding-top: 3rem; padding-bottom: 6rem; }
  .account-layout { display: grid; grid-template-columns: 260px 1fr; gap: 3rem; align-items: start; }
  .account-sidebar { background: #FFFFFF; border: 1px solid var(--border, rgba(43,27,20,0.1)); border-radius: var(--radius, 10px); overflow: hidden; position: sticky; top: 5.5rem; }
  .user-avatar-card { padding: 1.75rem 1.5rem; background: #FAF5EE; border-bottom: 1px solid rgba(43,27,20,0.08); display: flex; flex-direction: column; align-items: center; text-align: center; }
  .avatar-circle { width: 60px; height: 60px; border-radius: 50%; background: var(--primary, #4A2C1D); color: #E2B273; display: flex; align-items: center; justify-content: center; font-size: 1.35rem; font-weight: 700; margin-bottom: 0.75rem; }
  .user-display-name { font-size: 1.05rem; color: var(--primary, #4A2C1D); }
  .user-email-text { font-size: 0.75rem; color: var(--ink-2, #6B5A50); }
  .account-nav-list { padding: 0.75rem; display: flex; flex-direction: column; gap: 0.25rem; }
  .account-nav-link { display: flex; align-items: center; gap: 0.65rem; padding: 0.65rem 0.85rem; border-radius: 6px; font-size: 0.875rem; font-weight: 500; color: var(--ink, #2B1B14); text-decoration: none; }
  .account-nav-link.is-active { background: var(--primary, #4A2C1D); color: #FFFFFF; font-weight: 600; }
  .text-danger { color: #A8442A !important; }
  .account-heading { font-family: var(--font-head, 'Cormorant Garamond', Georgia, serif); font-size: 2.3rem; font-weight: 700; color: var(--primary, #4A2C1D); margin: 0 0 0.4rem; }
  .account-sub { font-size: 0.95rem; color: var(--ink-2, #6B5A50); margin: 0 0 2rem; }
  .password-card { background: #FFFFFF; border: 1px solid var(--border, rgba(43,27,20,0.1)); border-radius: var(--radius, 10px); padding: 2rem; max-width: 500px; }
  .form-group { margin-bottom: 1.25rem; }
  .form-group label { display: block; font-size: 0.84rem; font-weight: 600; color: var(--ink, #2B1B14); margin-bottom: 0.35rem; }
  .form-group input { width: 100%; padding: 0.65rem 0.85rem; border: 1px solid var(--border, rgba(43,27,20,0.15)); border-radius: 6px; font-size: 0.9rem; outline: none; box-sizing: border-box; }
  .form-group input:focus { border-color: var(--accent, #B9803A); }
  .btn-primary { background: var(--primary, #4A2C1D); color: #FFFFFF; border: none; padding: 0.85rem 1.75rem; border-radius: 6px; font-weight: 600; cursor: pointer; }
  .alert-box { padding: 0.75rem 1rem; border-radius: 6px; font-size: 0.85rem; margin-bottom: 1.25rem; }
  .alert-box.success { background: #D1FAE5; color: #065F46; border: 1px solid #A7F3D0; }
  .alert-box.error { background: #FEE2E2; color: #991B1B; border: 1px solid #FCA5A5; }
  @media (max-width: 900px) { .account-layout { grid-template-columns: 1fr; } }
</style>

<script>
  const form = document.getElementById('change-password-form') as HTMLFormElement | null;
  const alertBox = document.getElementById('pw-alert');
  const btn = document.getElementById('btn-save-pw') as HTMLButtonElement | null;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form || !alertBox || !btn) return;
    alertBox.style.display = 'none';

    const formData = new FormData(form);
    const cur = formData.get('current_password');
    const newP = formData.get('new_password');
    const conf = formData.get('confirm_password');

    if (newP !== conf) {
      alertBox.className = 'alert-box error';
      alertBox.textContent = 'New passwords do not match.';
      alertBox.style.display = 'block';
      return;
    }

    btn.disabled = true;
    btn.textContent = 'Updating...';

    try {
      const res = await fetch('/api/auth/change-password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ current_password: cur, new_password: newP }),
      });
      const data = await res.json();
      if (res.ok) {
        alertBox.className = 'alert-box success';
        alertBox.textContent = 'Your password has been securely updated.';
        alertBox.style.display = 'block';
        form.reset();
      } else {
        alertBox.className = 'alert-box error';
        alertBox.textContent = data.error || 'Failed to update password.';
        alertBox.style.display = 'block';
      }
    } catch {
      alertBox.className = 'alert-box error';
      alertBox.textContent = 'Network communication error.';
      alertBox.style.display = 'block';
    } finally {
      btn.disabled = false;
      btn.textContent = 'Update Password';
    }
  });
</script>

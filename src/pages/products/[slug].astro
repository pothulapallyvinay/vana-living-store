<script>
  // Variant chip switcher
  const chips = document.querySelectorAll('.variant-chip');
  let selectedVariantId = Number(document.getElementById('btn-add-cart-main')?.getAttribute('data-variant-id') || document.querySelector('.variant-chip.is-selected')?.getAttribute('data-variant-id') || 1);

  chips.forEach(chip => {
    chip.addEventListener('click', () => {
      chips.forEach(c => {
        c.classList.remove('is-selected');
        c.setAttribute('aria-checked', 'false');
      });
      chip.classList.add('is-selected');
      chip.setAttribute('aria-checked', 'true');

      selectedVariantId = Number(chip.getAttribute('data-variant-id'));
      const pricePaise = chip.getAttribute('data-price-paise');
      const comparePaise = chip.getAttribute('data-compare-paise');
      const stock = Number(chip.getAttribute('data-stock') || 0);

      // Update price display if priced
      if (pricePaise) {
        const priceEl = document.getElementById('active-price');
        if (priceEl) priceEl.textContent = `₹${Math.floor(Number(pricePaise) / 100).toLocaleString('en-IN')}`;
      }

      // Update stock display dynamically
      const stockText = document.getElementById('pdp-stock-text');
      const stockBadge = document.getElementById('pdp-stock-badge');
      const addCartBtn = document.getElementById('btn-add-cart-main') as HTMLButtonElement | null;
      const buyNowBtn = document.getElementById('btn-buy-now-main') as HTMLButtonElement | null;

      if (stock <= 0) {
        if (stockText) stockText.textContent = 'Out of Stock — Custom craft on request';
        if (stockBadge) stockBadge.className = 'pdp-stock-badge pdp-stock-badge--out';
        if (addCartBtn) {
          addCartBtn.disabled = true;
          addCartBtn.querySelector('span')!.textContent = 'Out of Stock';
        }
        if (buyNowBtn) {
          buyNowBtn.disabled = true;
          buyNowBtn.querySelector('span')!.textContent = 'Out of Stock';
        }
      } else {
        if (stockText) stockText.textContent = stock < 5 ? `Low Stock: Only ${stock} left in workshop` : `In Stock: ${stock} pieces ready to dispatch`;
        if (stockBadge) stockBadge.className = 'pdp-stock-badge pdp-stock-badge--in';
        if (addCartBtn) {
          addCartBtn.disabled = false;
          addCartBtn.querySelector('span')!.textContent = 'Add to Cart';
        }
        if (buyNowBtn) {
          buyNowBtn.disabled = false;
          buyNowBtn.querySelector('span')!.textContent = 'Instant Buy Now';
        }
      }
    });
  });

  // Quantity controls
  const minus = document.getElementById('qty-minus');
  const plus = document.getElementById('qty-plus');
  const input = document.getElementById('qty-input') as HTMLInputElement | null;

  minus?.addEventListener('click', () => {
    if (!input) return;
    const cur = parseInt(input.value || '1', 10);
    if (cur > 1) input.value = String(cur - 1);
  });

  plus?.addEventListener('click', () => {
    if (!input) return;
    const cur = parseInt(input.value || '1', 10);
    if (cur < 99) input.value = String(cur + 1);
  });

  // Add to cart main
  const addCartBtn = document.getElementById('btn-add-cart-main');
  const stickyCartBtn = document.getElementById('sticky-btn-cart');

  function addToCart() {
    const qty = parseInt(input?.value || '1', 10);
    try {
      const cart = JSON.parse(localStorage.getItem('cart') || '[]');
      const existing = cart.find((i: any) => i.variant_id === selectedVariantId);
      if (existing) {
        existing.qty += qty;
      } else {
        cart.push({ variant_id: selectedVariantId, qty });
      }
      localStorage.setItem('cart', JSON.stringify(cart));
      (window as any).refreshCartDrawer?.();

      if (addCartBtn) {
        const orig = addCartBtn.innerHTML;
        addCartBtn.innerHTML = '<span>Added to Cart! ✓</span>';
        addCartBtn.style.background = '#2F6B4F';
        setTimeout(() => {
          addCartBtn.innerHTML = orig;
          addCartBtn.style.background = '';
        }, 1800);
      }
    } catch (e) {
      console.error(e);
    }
  }

  addCartBtn?.addEventListener('click', addToCart);
  stickyCartBtn?.addEventListener('click', addToCart);

  // Buy now main
  const buyNowBtn = document.getElementById('btn-buy-now-main');
  buyNowBtn?.addEventListener('click', () => {
    addToCart();
    window.location.href = '/checkout';
  });

  // Wishlist Button Handlers
  document.querySelectorAll('.btn-pdp-wishlist').forEach(btn => {
    btn.addEventListener('click', (e) => {
      (window as any).handleWishlistToggle?.(e, btn);
    });
  });

  // Check wishlist state on load
  try {
    fetch('/api/wishlist')
      .then(r => r.ok ? r.json() : null)
      .then(data => {
        if (data?.product_ids && Array.isArray(data.product_ids)) {
          document.querySelectorAll('.btn-pdp-wishlist').forEach(btn => {
            const pId = btn.getAttribute('data-wishlist-id');
            if (pId && data.product_ids.includes(pId)) {
              btn.classList.add('is-active');
            }
          });
        }
      })
      .catch(() => {});
  } catch {}
</script>

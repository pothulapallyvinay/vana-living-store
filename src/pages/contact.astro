---
// src/pages/contact.astro
import Base from '../layouts/Base.astro';
import { site } from '../config/site';

const whatsappUrl = `https://wa.me/${site.whatsapp}?text=Hello%20${encodeURIComponent(site.name)}%2C%20I%20have%20an%20artisan%20enquiry`;
---

<Base title={`Contact Us & Workshop Enquiry — ${site.name}`}>
  <div class="site-container content-page-container">
    <div class="content-header">
      <span class="content-badge">WE ARE HERE TO ASSIST</span>
      <h1 class="content-title">Contact Our Artisan Studio</h1>
      <p class="content-lead">
        Reach out for custom dimension requests, order updates, interior design commissions, or corporate bulk gifting.
      </p>
    </div>

    <div class="contact-grid">
      <!-- Left: Contact Details & Fast WhatsApp -->
      <div class="contact-info-cards">
        <div class="info-card">
          <div class="icon-wrap whatsapp">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
          </div>
          <div>
            <h3>Direct WhatsApp Concierge</h3>
            <p>Immediate responses for custom sizing, photos, and stock questions.</p>
            <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn-whatsapp-direct">
              Chat on WhatsApp &rarr;
            </a>
          </div>
        </div>

        <div class="info-card">
          <div class="icon-wrap email">✉️</div>
          <div>
            <h3>Email Support</h3>
            <p>For detailed order correspondence, invoices, and high-res architectural plans.</p>
            <a href={`mailto:${site.supportEmail}`} class="contact-link">{site.supportEmail}</a>
          </div>
        </div>

        <div class="info-card">
          <div class="icon-wrap clock">⏰</div>
          <div>
            <h3>Studio & Workshop Hours</h3>
            <p>Monday – Saturday: 10:00 AM – 7:00 PM IST</p>
            <span class="sub-text">Closed on Indian National Holidays</span>
          </div>
        </div>
      </div>

      <!-- Right: Message Form -->
      <div class="contact-form-card">
        <h2 class="form-title">Send a Direct Message</h2>
        <div id="contact-alert" class="alert-msg" style="display:none;" role="alert"></div>

        <form id="contact-form" class="contact-form">
          <div class="form-group">
            <label for="contact-name">Your Full Name *</label>
            <input type="text" id="contact-name" name="name" required placeholder="e.g. Vikram Malhotra" />
          </div>

          <div class="form-row-2">
            <div class="form-group">
              <label for="contact-email">Email Address *</label>
              <input type="email" id="contact-email" name="email" required placeholder="vikram@example.com" />
            </div>
            <div class="form-group">
              <label for="contact-phone">Phone Number (10 digits)</label>
              <input type="tel" id="contact-phone" name="phone" placeholder="9876543210" maxlength="10" />
            </div>
          </div>

          <div class="form-group">
            <label for="contact-subject">Subject</label>
            <input type="text" id="contact-subject" name="subject" placeholder="Custom size inquiry, order status, etc." />
          </div>

          <div class="form-group">
            <label for="contact-message">Message Details *</label>
            <textarea id="contact-message" name="message" rows="5" required placeholder="Please describe the product name, wall dimensions, or questions you have..."></textarea>
          </div>

          <button type="submit" id="btn-contact-submit" class="btn-submit-contact">
            <span>Send Message</span>
          </button>
        </form>
      </div>
    </div>
  </div>
</Base>

<style>
  .content-page-container {
    padding-top: 3.5rem;
    padding-bottom: 6rem;
    max-width: 1200px;
  }

  .content-header {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 3.5rem;
  }

  .content-badge {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: var(--accent, #B9803A);
    display: inline-block;
    margin-bottom: 0.75rem;
  }

  .content-title {
    font-family: var(--font-head, 'Cormorant Garamond', Georgia, serif);
    font-size: 2.75rem;
    font-weight: 700;
    color: var(--primary, #4A2C1D);
    margin: 0 0 1rem;
    line-height: 1.15;
  }

  .content-lead {
    font-size: 1.1rem;
    color: var(--ink-2, #6B5A50);
    margin: 0;
    line-height: 1.6;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: 3.5rem;
    align-items: start;
  }

  .contact-info-cards {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .info-card {
    background: #FFFFFF;
    border: 1px solid var(--border, rgba(43,27,20,0.1));
    border-radius: var(--radius, 10px);
    padding: 1.5rem;
    display: flex;
    gap: 1.25rem;
  }

  .icon-wrap {
    width: 48px;
    height: 48px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.35rem;
    flex-shrink: 0;
  }

  .icon-wrap.whatsapp { background: #E6F8EE; color: #25D366; }
  .icon-wrap.email { background: #FAF5EE; }
  .icon-wrap.clock { background: #FAF5EE; }

  .info-card h3 {
    font-family: var(--font-head, 'Cormorant Garamond', Georgia, serif);
    font-size: 1.35rem;
    color: var(--primary, #4A2C1D);
    margin: 0 0 0.35rem;
  }

  .info-card p {
    font-size: 0.875rem;
    color: var(--ink-2, #6B5A50);
    margin: 0 0 0.75rem;
    line-height: 1.5;
  }

  .btn-whatsapp-direct {
    display: inline-block;
    background: #25D366;
    color: #FFFFFF;
    font-size: 0.8125rem;
    font-weight: 600;
    padding: 0.45rem 1rem;
    border-radius: 6px;
    text-decoration: none;
    transition: background 0.2s;
  }

  .btn-whatsapp-direct:hover {
    background: #1EBE5D;
  }

  .contact-link {
    color: var(--accent, #B9803A);
    font-weight: 600;
    text-decoration: none;
    font-size: 0.9375rem;
  }

  .sub-text {
    font-size: 0.75rem;
    color: var(--ink-2, #6B5A50);
  }

  /* Contact Form */
  .contact-form-card {
    background: #FFFFFF;
    border: 1px solid var(--border, rgba(43,27,20,0.1));
    border-radius: var(--radius, 10px);
    padding: 2.25rem;
  }

  .form-title {
    font-family: var(--font-head, 'Cormorant Garamond', Georgia, serif);
    font-size: 1.75rem;
    color: var(--primary, #4A2C1D);
    margin: 0 0 1.5rem;
  }

  .form-group {
    margin-bottom: 1.25rem;
  }

  .form-group label {
    display: block;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--ink, #2B1B14);
    margin-bottom: 0.4rem;
  }

  .form-group input,
  .form-group textarea {
    width: 100%;
    padding: 0.75rem 0.85rem;
    border: 1px solid var(--border, rgba(43,27,20,0.15));
    border-radius: 6px;
    font-size: 0.9rem;
    color: var(--ink, #2B1B14);
    box-sizing: border-box;
    outline: none;
  }

  .form-group input:focus,
  .form-group textarea:focus {
    border-color: var(--accent, #B9803A);
  }

  .form-row-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .btn-submit-contact {
    width: 100%;
    background: var(--primary, #4A2C1D);
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 0.9rem;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s;
  }

  .btn-submit-contact:hover {
    background: #3A2013;
  }

  .alert-msg {
    padding: 0.75rem 1rem;
    border-radius: 6px;
    font-size: 0.84rem;
    margin-bottom: 1.25rem;
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const alertBox = document.getElementById('contact-alert');
  const btn = document.getElementById('btn-contact-submit') as HTMLButtonElement | null;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form || !alertBox || !btn) return;
    alertBox.style.display = 'none';

    const formData = new FormData(form);
    btn.disabled = true;
    btn.textContent = 'Transmitting Message...';

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: formData.get('name'),
          email: formData.get('email'),
          phone: formData.get('phone'),
          subject: formData.get('subject'),
          message: formData.get('message'),
        }),
      });
      const data = await res.json();
      if (res.ok) {
        alertBox.style.background = '#D1FAE5';
        alertBox.style.color = '#065F46';
        alertBox.textContent = data.message || 'Message received! Our artisan team will reply promptly.';
        alertBox.style.display = 'block';
        form.reset();
      } else {
        alertBox.style.background = '#FEE2E2';
        alertBox.style.color = '#991B1B';
        alertBox.textContent = data.error || 'Failed to submit enquiry.';
        alertBox.style.display = 'block';
      }
    } catch {
      alertBox.style.background = '#FEE2E2';
      alertBox.style.color = '#991B1B';
      alertBox.textContent = 'Network communication error.';
      alertBox.style.display = 'block';
    } finally {
      btn.disabled = false;
      btn.textContent = 'Send Message';
    }
  });
</script>

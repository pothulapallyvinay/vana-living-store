---
// src/pages/faq.astro
// Frequently Asked Questions with structured FAQPage JSON-LD
import Base from '../layouts/Base.astro';
import { site, shipping } from '../config/site';

const faqs = [
  {
    q: "What materials and wood species are used in your 3D wall sculptures?",
    a: "We craft our layered artwork from sustainably harvested Baltic birch cross-laminated plywood and authentic solid walnut veneers. We select these woods for their structural stability, warp resistance in varying Indian climates, and clean laser-cut edges without heavy burning or charring."
  },
  {
    q: "How are the heavy multi-layered wall art pieces mounted safely?",
    a: "Every large wall mandala and framed sculpture comes equipped with a heavy-duty rear French cleat aluminum or interlocking wooden bracket system. You mount one half to your wall studs/anchors and the artwork drops smoothly and securely over it, sitting perfectly flush against the wall."
  },
  {
    q: "Do the pendant and table lamps come with electrical fittings and bulbs?",
    a: "Yes. All our pendant lights include a certified CE/BIS-compliant E27 brass/ceramic lamp socket, 1.5 to 2 meters of vintage braided fabric suspension cable, and a matching solid wood ceiling canopy rose. Table lamps and night lights include a plug-in adapter and integrated 3000K warm ambient LED illumination."
  },
  {
    q: "How does Cash on Delivery (COD) and COD-with-advance work?",
    a: `Standard Cash on Delivery is available for all orders up to ₹${Math.floor(shipping.codLimitPaise / 100).toLocaleString('en-IN')}. For higher-value custom architectural commissions, we request a ${shipping.advancePercent}% online advance via Razorpay to cover raw timber cutting, with the remaining 70% payable comfortably at your doorstep upon parcel delivery.`
  },
  {
    q: "What is your transit damage policy? Are packages insured?",
    a: "Every artwork is shipped inside a custom-built, reinforced corrugated wooden crate with multi-density foam suspension. In the extremely rare event of transit damage, simply take a photo within 48 hours of delivery and share it with our WhatsApp concierge. We will dispatch a brand-new replacement at zero cost without demanding tedious courier claims."
  },
  {
    q: "Can I commission custom dimensions, hotel projects, or bespoke wood stains?",
    a: "Absolutely. As an artisan studio, we frequently tailor mandalas and lighting installations for architect projects, villas, temples, and corporate offices. Reach out via WhatsApp or our Bulk Orders page with your wall dimensions."
  },
  {
    q: "How do I track my order after purchasing?",
    a: "Once your piece passes quality inspection and is dispatched, you receive an automated SMS, WhatsApp, and email with the courier tracking AWB link. You can also view live delivery milestones directly on your Order Status page."
  }
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.a
    }
  }))
};
---

<Base title={`Frequently Asked Questions — ${site.name}`} jsonLd={faqJsonLd}>
  <div class="site-container content-page-container">
    <div class="content-header">
      <span class="content-badge">ARTISAN HELP CENTER</span>
      <h1 class="content-title">Frequently Asked Questions</h1>
      <p class="content-lead">
        Everything you need to know about our handcrafted materials, wall mounting, lighting specs, and all-India delivery.
      </p>
    </div>

    <div class="faq-accordion-list">
      {faqs.map((f, idx) => (
        <details class="faq-item" open={idx === 0}>
          <summary class="faq-summary">
            <span class="faq-q">{f.q}</span>
            <span class="faq-icon">▼</span>
          </summary>
          <div class="faq-answer">
            <p>{f.a}</p>
          </div>
        </details>
      ))}
    </div>

    <div class="faq-help-cta">
      <h3>Have a custom design or sizing question?</h3>
      <p>Our workshop team is available on WhatsApp to assist with bespoke dimensions.</p>
      <a href={`https://wa.me/${site.whatsapp}?text=Hello%20${encodeURIComponent(site.name)}%2C%20I%20have%20a%20question`} target="_blank" rel="noopener noreferrer" class="btn-whatsapp-faq">
        Chat with Workshop Team &rarr;
      </a>
    </div>
  </div>
</Base>

<style>
  .content-page-container {
    padding-top: 3.5rem;
    padding-bottom: 6rem;
    max-width: 900px;
  }

  .content-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .content-badge {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: var(--accent, #B9803A);
    display: inline-block;
    margin-bottom: 0.75rem;
  }

  .content-title {
    font-family: var(--font-head, 'Cormorant Garamond', Georgia, serif);
    font-size: 2.75rem;
    font-weight: 700;
    color: var(--primary, #4A2C1D);
    margin: 0 0 1rem;
    line-height: 1.15;
  }

  .content-lead {
    font-size: 1.05rem;
    color: var(--ink-2, #6B5A50);
    margin: 0;
    line-height: 1.6;
  }

  .faq-accordion-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 4rem;
  }

  .faq-item {
    background: #FFFFFF;
    border: 1px solid var(--border, rgba(43,27,20,0.1));
    border-radius: var(--radius, 10px);
    overflow: hidden;
    transition: border-color 0.2s;
  }

  .faq-item[open] {
    border-color: var(--accent, #B9803A);
    box-shadow: 0 4px 15px rgba(43,27,20,0.05);
  }

  .faq-summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 1.5rem;
    cursor: pointer;
    list-style: none;
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--primary, #4A2C1D);
  }

  .faq-summary::-webkit-details-marker {
    display: none;
  }

  .faq-icon {
    font-size: 0.75rem;
    color: var(--accent, #B9803A);
    transition: transform 0.2s;
    margin-left: 1rem;
  }

  .faq-item[open] .faq-icon {
    transform: rotate(180deg);
  }

  .faq-answer {
    padding: 0 1.5rem 1.5rem;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--ink-2, #6B5A50);
    border-top: 1px solid rgba(43,27,20,0.06);
    padding-top: 1rem;
  }

  .faq-answer p {
    margin: 0;
  }

  .faq-help-cta {
    text-align: center;
    background: #FAF5EE;
    border: 1px solid rgba(185, 128, 58, 0.25);
    border-radius: 12px;
    padding: 2.5rem 2rem;
  }

  .faq-help-cta h3 {
    font-family: var(--font-head, 'Cormorant Garamond', Georgia, serif);
    font-size: 1.75rem;
    color: var(--primary, #4A2C1D);
    margin: 0 0 0.5rem;
  }

  .faq-help-cta p {
    color: var(--ink-2, #6B5A50);
    margin: 0 0 1.5rem;
  }

  .btn-whatsapp-faq {
    display: inline-block;
    background: #25D366;
    color: #FFFFFF;
    font-size: 0.9rem;
    font-weight: 600;
    padding: 0.75rem 1.75rem;
    border-radius: 6px;
    text-decoration: none;
    transition: background 0.2s;
  }

  .btn-whatsapp-faq:hover {
    background: #1EBE5D;
  }
</style>
